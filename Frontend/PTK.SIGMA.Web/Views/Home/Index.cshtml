                                                                    @section Scripts {
                                                                        <script>
                                                                            let currentCategory = '';
                                                                            let currentSearch = '';
                                                                            let currentFilter = '';
                                                                            let currentPage = 1;
                                                                             let currentPageSize = 8;
                                                                             let currentSort = 'terbaru';
                                                                             let currentViewMode = 'grid';
                                                                            let currentUserRole = '';
                                                                            let dashboardCache = null;
                                                                             let currentInventoryItems = [];
                                                                            let searchDebounceTimer;
                                                                             let dashboardSummaryAbortController;
                                                                             let dashboardInventoryAbortController;
                                                                            let lockedTrendBarKey = '';
                                                                            const chartColors = ['#1477e6', '#22ba79', '#ff9818', '#8c4fe8', '#5b7089', '#10b8c9'];

                                                                            document.addEventListener('DOMContentLoaded', async () => {
                                                                                const searchInput = document.getElementById('searchStringInput');
                                                                                searchInput.addEventListener('input', () => {
                                                                                    window.clearTimeout(searchDebounceTimer);
                                                                                     dashboardInventoryAbortController?.abort();
                                                                                     const nextSearch = searchInput.value.trim();
                                                                                     if (!nextSearch) {
                                                                                         currentSearch = '';
                                                                                         loadDashboardData(1);
                                                                                         return;
                                                                                     }
                                                                                    setSearchState('Menunggu...');
                                                                                    searchDebounceTimer = window.setTimeout(() => {
                                                                                         currentSearch = nextSearch;
                                                                                        loadDashboardData(1);
                                                                                     }, 200);
                                                                                });
                                                                                document.getElementById('trendRangeFilter').addEventListener('change', renderVisualizations);
                                                                                document.getElementById('distributionCategoryFilter').addEventListener('change', renderVisualizations);
                                                                                 document.getElementById('inventorySort').addEventListener('change', event => {
                                                                                     currentSort = event.target.value || 'terbaru';
                                                                                     loadDashboardData(1);
                                                                                 });
                                                                                 document.getElementById('inventoryPageSize').addEventListener('change', event => {
                                                                                     currentPageSize = Number(event.target.value) || 8;
                                                                                     loadDashboardData(1);
                                                                                 });
                                                                                 setInventoryView('grid', false);
                                                                                bindTrendInteractions();
                                                                                await loadDashboardData(1);
                                                                                window.addEventListener('sigma:notification', () => loadDashboardData(currentPage, true));
                                                                            });

                                                                             async function loadDashboardData(page = 1, refreshSummary = false) {
                                                                                 const inventoryPromise = loadInventoryData(page);
                                                                                 const summaryPromise = (refreshSummary || dashboardCache === null)
                                                                                     ? loadDashboardSummary()
                                                                                     : Promise.resolve();

                                                                                 // Summary and inventory use separate requests/DbContexts. A
                                                                                 // search never waits for charts, logs, or KPI aggregation.
                                                                                 await Promise.allSettled([inventoryPromise, summaryPromise]);
                                                                             }

                                                                             async function loadDashboardSummary() {
                                                                                 dashboardSummaryAbortController?.abort();
                                                                                 const requestController = new AbortController();
                                                                                 dashboardSummaryAbortController = requestController;

                                                                                 try {
                                                                                     const response = await fetch('/api/home/summary', {
                                                                                         credentials: 'include',
                                                                                         signal: requestController.signal
                                                                                     });
                                                                                     if (response.status === 401) { window.location.href = '/Auth/Login'; return; }
                                                                                     if (!response.ok) throw new Error(`HTTP ${response.status}`);

                                                                                     const result = await response.json();
                                                                                     const dashboard = result?.data || result || {};
                                                                                     const categories = Array.isArray(dashboard.kategoriList) ? dashboard.kategoriList : [];
                                                                                     dashboardCache = dashboard;
                                                                                     currentUserRole = dashboard.isAdmin ? 'Admin' : '';
                                                                                     updateStats(dashboard, categories.length);
                                                                                     populateDistributionFilter(dashboard.categoryDistribution || []);
                                                                                     renderVisualizations();
                                                                                     renderCategories(categories);
                                                                                     renderActivityLogs(dashboard.logs || []);
                                                                                 } catch (error) {
                                                                                     if (error?.name !== 'AbortError') console.error('Gagal memuat ringkasan dashboard:', error);
                                                                                 } finally {
                                                                                     if (dashboardSummaryAbortController === requestController) dashboardSummaryAbortController = null;
                                                                                 }
                                                                             }

                                                                             async function loadInventoryData(page = 1) {
                                                                                 currentPage = Math.max(1, page);
                                                                                 setSearchState('Memuat...');
                                                                                 let url = `/api/home/inventory?page=${currentPage}&pageSize=${currentPageSize}&sort=${encodeURIComponent(currentSort)}`;
                                                                                 if (currentCategory) url += `&category=${encodeURIComponent(currentCategory)}`;
                                                                                 if (currentSearch) url += `&search=${encodeURIComponent(currentSearch)}`;
                                                                                 if (currentFilter) url += `&filter=${encodeURIComponent(currentFilter)}`;

                                                                                 dashboardInventoryAbortController?.abort();
                                                                                 const requestController = new AbortController();
                                                                                 dashboardInventoryAbortController = requestController;
                                                                                 try {
                                                                                     const response = await fetch(url, { credentials: 'include', signal: requestController.signal });
                                                                                     if (response.status === 401) { window.location.href = '/Auth/Login'; return; }
                                                                                     if (!response.ok) throw new Error(`HTTP ${response.status}`);
                                                                                     const result = await response.json();
                                                                                     const inventory = result?.data || result;
                                                                                     const items = Array.isArray(inventory?.data) ? inventory.data : [];
                                                                                     const pagination = inventory?.pagination || { totalPages: 1, currentPage, totalItems: items.length };
                                                                                     currentInventoryItems = items;
                                                                                     currentPageSize = Number(pagination.pageSize) || currentPageSize;
                                                                                     currentPage = Number(pagination.currentPage) || currentPage;
                                                                                     document.getElementById('inventoryPageSize').value = String(currentPageSize);
                                                                                     renderInventory(items, currentPage);
                                                                                     renderPagination(pagination.totalPages || 1, pagination.currentPage || currentPage);
                                                                                     document.getElementById('inventoryCount').textContent = `${pagination.totalItems || 0}`;
                                                                                     document.getElementById('inventoryRange').textContent = `Menampilkan ${items.length} dari ${pagination.totalItems || 0} perangkat`;
                                                                                     setSearchState('');
                                                                                 } catch (error) {
                                                                                     if (error?.name === 'AbortError') return;
                                                                                     console.error('Gagal memuat inventaris:', error);
                                                                                     currentInventoryItems = [];
                                                                                     renderInventoryError('Data belum dapat dimuat. Silakan coba lagi.');
                                                                                     setSearchState('Gagal');
                                                                                 } finally {
                                                                                     if (dashboardInventoryAbortController === requestController) dashboardInventoryAbortController = null;
                                                                                 }
                                                                             }

                                                                            function populateDistributionFilter(rows) {
                                                                                const select = document.getElementById('distributionCategoryFilter');
                                                                                const selectedValue = select.value;
                                                                                select.innerHTML = '<option value="">Semua Kategori</option>' + rows.map(row => `<option value="${escapeHtml(row.name)}">${escapeHtml(row.name)}</option>`).join('');
                                                                                if ([...select.options].some(option => option.value === selectedValue)) select.value = selectedValue;
                                                                            }

                                                                            function renderVisualizations() {
                                                                                if (!dashboardCache) return;
                                                                                const monthCount = Number(document.getElementById('trendRangeFilter').value) || 6;
                                                                                const trendRows = Array.isArray(dashboardCache.monthlyTrend) ? dashboardCache.monthlyTrend.slice(-monthCount) : [];
                                                                                renderTrend(trendRows);

                                                                                const allRows = Array.isArray(dashboardCache.categoryDistribution)
                                                                                    ? dashboardCache.categoryDistribution.map((row, index) => ({
                                                                                        ...row,
                                                                                        chartColor: chartColors[index % chartColors.length]
                                                                                    }))
                                                                                    : [];
                                                                                const selectedCategory = document.getElementById('distributionCategoryFilter').value;
                                                                                if (selectedCategory) {
                                                                                    const selectedRows = allRows.filter(row => row.name === selectedCategory);
                                                                                    renderDistribution(selectedRows, selectedRows.reduce((sum, row) => sum + Number(row.total || 0), 0));
                                                                                    return;
                                                                                }

                                                                                const visibleRows = allRows.slice(0, 5);
                                                                                if (allRows.length > 5) {
                                                                                    visibleRows.push({
                                                                                        name: 'Lainnya',
                                                                                        total: allRows.slice(5).reduce((sum, row) => sum + Number(row.total || 0), 0),
                                                                                        chartColor: '#71849a'
                                                                                    });
                                                                                }
                                                                                renderDistribution(visibleRows, dashboardCache.totalUnits || 0);
                                                                            }

                                                                            function updateStats(data, fallbackCategories) {
                                                                                setText('statTotalUnits', data.totalUnits || 0);
                                                                                setText('statTotalCategories', data.totalCategories ?? fallbackCategories ?? 0);
                                                                                setText('statCriticalItems', data.criticalItems || 0);
                                                                                setText('statBorrowedUnits', data.borrowedUnits || 0);

                                                                                // Status toner
                                                                                const tonerStats = data.tonerStats || {};
                                                                                setText('statTotalToner', data.tonerUnits ?? data.totalToner ?? tonerStats.total ?? 0);
                                                                                setText('statLowToner', data.tonerCritical ?? data.lowToner ?? tonerStats.lowStock ?? 0);
                                                                                setText('statTonerTypes', data.tonerItems ?? tonerStats.itemTypes ?? 0);
                                                                            }

                                                                            function renderTrend(rows) {
                                                                                const host = document.getElementById('stockTrendChart');
                                                                                lockedTrendBarKey = '';
                                                                                host.style.gridTemplateColumns = `repeat(${Math.max(rows.length, 1)}, minmax(24px, 1fr))`;
                                                                                if (!rows.length) { host.innerHTML = '<div class="chart-empty">Belum ada data inventaris pada periode ini.</div>'; return; }
                                                                                const max = Math.max(1, ...rows.flatMap(row => [row.total || 0, row.good || 0, row.damaged || 0]));
                                                                                const metrics = [
                                                                                    { key: 'total', label: 'Total Unit Inventaris', className: 'trend-total', icon: 'bi-boxes' },
                                                                                    { key: 'good', label: 'Barang Baik', className: 'trend-good', icon: 'bi-check-circle' },
                                                                                    { key: 'damaged', label: 'Barang Rusak', className: 'trend-damaged', icon: 'bi-exclamation-triangle' }
                                                                                ];

                                                                                host.innerHTML = rows.map((row, rowIndex) => {
                                                                                    const rawMonthLabel = String(row.label || '-');
                                                                                    const fullMonthLabel = row.year ? `${rawMonthLabel} ${row.year}` : rawMonthLabel;
                                                                                    const monthLabel = escapeHtml(rawMonthLabel);
                                                                                    const bars = metrics.map(metric => {
                                                                                        const value = Number(row[metric.key] || 0);
                                                                                        const height = value > 0 ? Math.max(2, Math.round((value / max) * 100)) : 0;
                                                                                        const barKey = `${row.period || rowIndex}-${metric.key}`;
                                                                                        const zeroClass = value === 0 ? ' is-zero' : '';
                                                                                        return `<button type="button" class="trend-bar-button${zeroClass}" data-trend-key="${barKey}" data-trend-label="${escapeHtml(metric.label)}" data-trend-month="${escapeHtml(fullMonthLabel)}" data-trend-value="${value}" aria-label="${escapeHtml(metric.label)} ${escapeHtml(fullMonthLabel)}: ${value} unit. Klik untuk mengunci detail." aria-pressed="false"><span class="trend-bar-track"><span class="trend-bar ${metric.className}" style="height:${height}%"></span></span><strong class="trend-bar-value">${value}</strong></button>`;
                                                                                    }).join('');
                                                                                    return `<div class="trend-month"><div class="trend-bars">${bars}</div><small>${monthLabel}</small></div>`;
                                                                                }).join('') + '<div id="trendChartTooltip" class="trend-chart-tooltip" role="tooltip" aria-hidden="true"></div>';
                                                                            }

                                                                            function bindTrendInteractions() {
                                                                                const host = document.getElementById('stockTrendChart');

                                                                                host.addEventListener('pointerover', event => {
                                                                                    const bar = event.target.closest('.trend-bar-button');
                                                                                    if (!bar || (lockedTrendBarKey && lockedTrendBarKey !== bar.dataset.trendKey)) return;
                                                                                    showTrendTooltip(bar, event);
                                                                                });

                                                                                host.addEventListener('pointermove', event => {
                                                                                    const bar = event.target.closest('.trend-bar-button');
                                                                                    if (!bar || lockedTrendBarKey) return;
                                                                                    positionTrendTooltip(event);
                                                                                });

                                                                                host.addEventListener('pointerout', event => {
                                                                                    if (lockedTrendBarKey || event.relatedTarget?.closest?.('.trend-bar-button')) return;
                                                                                    hideTrendTooltip();
                                                                                });

                                                                                host.addEventListener('focusin', event => {
                                                                                    const bar = event.target.closest('.trend-bar-button');
                                                                                    if (bar && (!lockedTrendBarKey || lockedTrendBarKey === bar.dataset.trendKey)) showTrendTooltip(bar);
                                                                                });

                                                                                host.addEventListener('focusout', () => {
                                                                                    if (!lockedTrendBarKey) hideTrendTooltip();
                                                                                });

                                                                                host.addEventListener('click', event => {
                                                                                    const bar = event.target.closest('.trend-bar-button');
                                                                                    if (!bar) return;
                                                                                    const nextKey = lockedTrendBarKey === bar.dataset.trendKey ? '' : bar.dataset.trendKey;
                                                                                    lockedTrendBarKey = nextKey;
                                                                                    host.querySelectorAll('.trend-bar-button').forEach(item => {
                                                                                        const isLocked = Boolean(nextKey) && item.dataset.trendKey === nextKey;
                                                                                        item.classList.toggle('is-locked', isLocked);
                                                                                        item.setAttribute('aria-pressed', String(isLocked));
                                                                                    });
                                                                                    if (nextKey) showTrendTooltip(bar, event, true);
                                                                                    else hideTrendTooltip();
                                                                                });

                                                                                host.addEventListener('keydown', event => {
                                                                                    if (event.key !== 'Escape') return;
                                                                                    lockedTrendBarKey = '';
                                                                                    host.querySelectorAll('.trend-bar-button.is-locked').forEach(item => {
                                                                                        item.classList.remove('is-locked');
                                                                                        item.setAttribute('aria-pressed', 'false');
                                                                                    });
                                                                                    hideTrendTooltip();
                                                                                });
                                                                            }

                                                                            function showTrendTooltip(bar, pointerEvent = null, locked = false) {
                                                                                const tooltip = document.getElementById('trendChartTooltip');
                                                                                if (!tooltip) return;
                                                                                tooltip.innerHTML = `<span class="trend-tooltip-kicker"><i class="bi bi-bar-chart-fill"></i>${escapeHtml(bar.dataset.trendMonth || '-')}</span><strong>${escapeHtml(bar.dataset.trendLabel || '-')}</strong><b>${Number(bar.dataset.trendValue || 0).toLocaleString('id-ID')} <small>unit</small></b><span class="trend-tooltip-hint"><i class="bi ${locked || lockedTrendBarKey ? 'bi-lock-fill' : 'bi-cursor-fill'}"></i>${locked || lockedTrendBarKey ? 'Detail dikunci &middot; klik lagi untuk melepas' : 'Klik bar untuk mengunci detail'}</span>`;
                                                                                tooltip.classList.add('is-visible');
                                                                                tooltip.setAttribute('aria-hidden', 'false');

                                                                                if (pointerEvent?.clientX) positionTrendTooltip(pointerEvent);
                                                                                else positionTrendTooltipAtBar(bar);
                                                                            }

                                                                            function positionTrendTooltip(pointerEvent) {
                                                                                const bar = pointerEvent.target?.closest?.('.trend-bar-button');
                                                                                if (bar) positionTrendTooltipAtBar(bar);
                                                                            }

                                                                            function positionTrendTooltipAtBar(bar) {
                                                                                const host = document.getElementById('stockTrendChart');
                                                                                const tooltip = document.getElementById('trendChartTooltip');
                                                                                const hostBounds = host.getBoundingClientRect();
                                                                                const barBounds = (bar.querySelector('.trend-bar') || bar).getBoundingClientRect();
                                                                                const tooltipWidth = tooltip.offsetWidth || 188;
                                                                                const tooltipHeight = tooltip.offsetHeight || 104;
                                                                                const gutter = 14;
                                                                                const availableRight = hostBounds.right - barBounds.right;
                                                                                const placeRight = availableRight >= tooltipWidth + gutter;
                                                                                const preferredX = placeRight
                                                                                    ? (barBounds.right - hostBounds.left) + gutter + (tooltipWidth / 2)
                                                                                    : (barBounds.left - hostBounds.left) - gutter - (tooltipWidth / 2);
                                                                                const x = Math.min(Math.max(preferredX, (tooltipWidth / 2) + 8), hostBounds.width - (tooltipWidth / 2) - 8);
                                                                                const anchorCenterY = (barBounds.top - hostBounds.top) + (barBounds.height / 2);
                                                                                const y = Math.min(Math.max(anchorCenterY - (tooltipHeight / 2), 8), hostBounds.height - tooltipHeight - 8);
                                                                                tooltip.style.left = `${x}px`;
                                                                                tooltip.style.top = `${y}px`;
                                                                            }

                                                                            function hideTrendTooltip() {
                                                                                const tooltip = document.getElementById('trendChartTooltip');
                                                                                if (!tooltip) return;
                                                                                tooltip.classList.remove('is-visible');
                                                                                tooltip.setAttribute('aria-hidden', 'true');
                                                                            }

                                                                            function renderDistribution(rows, totalUnits) {
                                                                                const donut = document.getElementById('categoryDonut');
                                                                                const legend = document.getElementById('categoryLegend');
                                                                                const total = Number(totalUnits) || rows.reduce((sum, row) => sum + Number(row.total || 0), 0);
                                                                                setText('donutTotal', total);
                                                                                if (!rows.length || total === 0) { donut.style.background = '#e8eff6'; legend.innerHTML = '<div class="chart-empty">Belum ada kategori.</div>'; return; }
                                                                                let progress = 0;
                                                                                const segments = rows.map((row, index) => {
                                                                                    const start = progress;
                                                                                    progress += (Number(row.total || 0) / total) * 100;
                                                                                    return `${row.chartColor || chartColors[index % chartColors.length]} ${start}% ${progress}%`;
                                                                                });
                                                                                if (progress < 100) segments.push(`#e8eff6 ${progress}% 100%`);
                                                                                donut.style.background = `conic-gradient(${segments.join(',')})`;
                                                                                legend.innerHTML = rows.map((row, index) => {
                                                                                    const percentage = total ? ((Number(row.total || 0) / total) * 100).toFixed(1) : '0.0';
                                                                                    const rowColor = row.chartColor || chartColors[index % chartColors.length];
                                                                                    return `<div class="category-legend-row" style="--category-color:${rowColor}"><i></i><span title="${escapeHtml(row.name)}">${escapeHtml(row.name)}</span><b>${Number(row.total || 0).toLocaleString('id-ID')} <em>unit</em></b><small>${percentage}%</small></div>`;
                                                                                }).join('');
                                                                            }

                                                                            function setInventoryView(mode, announce = true) {
                                                                                const allowedModes = ['grid', 'compact', 'list'];
                                                                                currentViewMode = allowedModes.includes(mode) ? mode : 'grid';
                                                                                const views = {
                                                                                    grid: document.getElementById('inventoryGridView'),
                                                                                    compact: document.getElementById('inventoryCompactView'),
                                                                                    list: document.getElementById('inventoryListView')
                                                                                };
                                                                                Object.entries(views).forEach(([key, element]) => {
                                                                                    if (element) element.hidden = key !== currentViewMode;
                                                                                });
                                                                                document.querySelectorAll('.inventory-view-button').forEach(button => {
                                                                                    const active = button.dataset.view === currentViewMode;
                                                                                    button.classList.toggle('active', active);
                                                                                    button.setAttribute('aria-pressed', String(active));
                                                                                });
                                                                                if (announce) {
                                                                                    const labels = { grid: 'Grid 4 kolom', compact: 'Kartu 2 kolom', list: 'List satu per baris' };
                                                                                    setSearchState(labels[currentViewMode]);
                                                                                    if (currentInventoryItems.length) renderInventory(currentInventoryItems, currentPage);
                                                                                }
                                                                            }

                                                                            function getInventoryViewModel(item, index, page) {
                                                                                const condition = item.kondisi?.trim() || 'Baik';
                                                                                const conditionText = condition.toLowerCase();
                                                                                const damaged = conditionText.includes('rusak') && !conditionText.includes('baik');
                                                                                const createdAt = item.createdAt ? new Date(item.createdAt) : null;
                                                                                const validDate = createdAt && !Number.isNaN(createdAt.getTime());
                                                                                return {
                                                                                    id: Number(item.id) || 0,
                                                                                    index,
                                                                                    number: ((page - 1) * currentPageSize) + index + 1,
                                                                                    name: item.nama || '-',
                                                                                    category: item.kategori || 'Perangkat ICT Operation',
                                                                                    condition,
                                                                                    damaged,
                                                                                    serial: item.snLaptop || 'SN belum tersedia',
                                                                                    quantity: Number(item.jumlah) || 0,
                                                                                    unit: item.kategori === 'Tinta / Toner / Cartridge' ? 'Pcs' : 'Unit',
                                                                                    location: item.namaLokasi || item.lokasi?.namaLokasi || 'Lokasi belum diatur',
                                                                                    note: item.keterangan || 'Tanpa keterangan',
                                                                                    date: validDate ? createdAt.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-',
                                                                                    imageUrl: resolveImage(item.dokumentasi)
                                                                                };
                                                                            }

                                                                            function renderInventoryImage(model) {
                                                                                if (!model.imageUrl) {
                                                                                    return '<span class="device-image-fallback"><i class="bi bi-image"></i><small>Belum ada foto</small></span>';
                                                                                }
                                                                                return `<img src="${escapeHtml(model.imageUrl)}" alt="Foto ${escapeHtml(model.name)}" loading="lazy" decoding="async" fetchpriority="low" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span class="device-image-fallback" hidden><i class="bi bi-image"></i><small>Foto tidak tersedia</small></span>`;
                                                                            }

                                                                            function renderInventoryActions(model, labels = true) {
                                                                                const labelClass = labels ? '' : ' class="visually-hidden"';
                                                                                const adminActions = currentUserRole.toLowerCase() === 'admin'
                                                                                    ? `<a class="inventory-action-edit" href="/Perangkat/Edit?id=${model.id}" onclick="event.stopPropagation()" title="Edit"><i class="bi bi-pencil-square"></i><span${labelClass}>Edit</span></a><button class="inventory-action-delete" type="button" onclick="event.stopPropagation(); deletePerangkat(${model.id})" title="Hapus"><i class="bi bi-trash3"></i><span${labelClass}>Hapus</span></button>`
                                                                                    : '';
                                                                                return `<div class="inventory-item-actions" onclick="event.stopPropagation()"><button class="inventory-action-view" type="button" onclick="openDetailModalByIndex(${model.index})" title="Lihat detail"><i class="bi bi-eye"></i><span${labelClass}>Lihat</span></button>${adminActions}</div>`;
                                                                            }

                                                                            function renderInventory(items, page) {
                                                                                const grid = document.getElementById('inventoryGridView');
                                                                                const compact = document.getElementById('inventoryCompactView');
                                                                                const list = document.getElementById('inventoryListView');
                                                                                const tbody = document.getElementById('inventoryTableBody');
                                                                                if (!items.length) {
                                                                                    const empty = '<div class="inventory-empty-state"><i class="bi bi-inbox"></i><strong>Data tidak ditemukan</strong><span>Ubah kata kunci atau kategori pencarian.</span></div>';
                                                                                    grid.innerHTML = currentViewMode === 'grid' ? empty : '';
                                                                                    compact.innerHTML = currentViewMode === 'compact' ? empty : '';
                                                                                    list.innerHTML = currentViewMode === 'list' ? empty : '';
                                                                                    tbody.innerHTML = '';
                                                                                    return;
                                                                                }

