                                    <div>
                                        <span class="panel-icon" style="color:#1477e6;background:rgba(20,119,230,.1);"><i
                                            class="bi bi-printer-fill"></i></span>
                                            <div><strong>Status Khusus Toner</strong><small>Pantauan stok Tinta / Toner / Cartridge berdasarkan data
                                                backend</small></div>
                                            </div>
                                        <button type="button" class="dashboard-toner-link"
                                                onclick="filterDashboard('Tinta / Toner / Cartridge', '', '')">
                                            <span>Lihat Detail Toner</span><i class="bi bi-arrow-right"></i>
                                        </button>
                                        </header>
                                        <div class="dashboard-status-grid dashboard-toner-grid">
