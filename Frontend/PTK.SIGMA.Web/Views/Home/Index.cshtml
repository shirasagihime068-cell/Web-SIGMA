                                                                                grid.innerHTML = currentViewMode === 'grid' ? models.map(model => `
                                                                                    <article class="inventory-product-card" data-item-index="${model.index}" tabindex="0" role="button" aria-label="Lihat detail ${escapeHtml(model.name)}">
