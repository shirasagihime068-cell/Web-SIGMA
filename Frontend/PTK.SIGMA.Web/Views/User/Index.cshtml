@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var apiBaseUrl = "";
    ViewData["Title"] = "Manajemen Pengguna - SIGMA";
}

<!-- STYLE KHUSUS HALAMAN INI -->
<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeInUp 0.4s ease-out forwards;
    }

    @@keyframes dropdownFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-dropdown {
        animation: dropdownFade 0.2s ease-out forwards;
    }

    .bg-pertamina-red {
        background-color: #ED1B24 !important;
    }

    .text-pertamina-red {
        color: #ED1B24 !important;
    }

    .btn-pertamina-red {
        background-color: #ED1B24;
        color: white;
        border: none;
    }

    .btn-pertamina-red:hover {
        background-color: #d0121a;
        color: white;
    }

    .bg-pertamina-blue {
        background-color: #003876 !important;
    }

    .btn-pertamina-blue {
        background-color: #003876;
        color: white;
        border: none;
    }

    .btn-pertamina-blue:hover {
        background-color: #002b5c;
        color: white;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #003876 !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 56, 118, 0.15) !important;
    }

    .dropdown-role:hover {
        background-color: #e6f0fa;
        color: #003876 !important;
    }
</style>

<!-- KONTEN UTAMA -->
<div class="container py-4 px-2 px-md-4 animate-fade-in" style="max-width: 1300px;">

    <!-- CARD ATAS -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div
            class="card-body p-3 p-md-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                     style="width: 50px; height: 50px;">
                    <i class="bi bi-people-fill text-primary fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark m-0 fs-6 fs-md-5">Manajemen Pengguna</h5>
                    <p class="text-muted small m-0 mt-1">Kelola daftar akun yang memiliki akses ke sistem gudang.</p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-end">
                <a href="/Home/Index"
                   class="btn btn-light border rounded-pill px-3 py-2 fw-semibold text-dark shadow-sm d-flex align-items-center text-nowrap flex-grow-1 flex-md-grow-0 justify-content-center"
                   style="font-size: 0.85rem;">
                    Kembali
                </a>
                <a href="/User/Create"
                   class="btn btn-pertamina-red rounded-pill px-3 py-2 fw-semibold shadow-sm d-flex align-items-center text-nowrap flex-grow-1 flex-md-grow-0 justify-content-center"
                   style="font-size: 0.85rem;">
                    <i class="bi bi-plus-lg me-1"></i> Tambah Pengguna
                </a>
            </div>
        </div>
    </div>

    <!-- CARD BAWAH -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-5">
        <div class="card-body p-3 p-md-5">

            <!-- FORM FILTER & PENCARIAN -->
            <form id="filterForm">
                <div class="row g-2 mb-4 align-items-center">

                    <!-- Dropdown Filter Role -->
                    <div class="col-12 col-lg-4">
                        <div class="input-group bg-light rounded-pill px-3 py-2 border shadow-sm align-items-center">
                            <span class="text-primary me-2 fs-5"><i class="bi bi-filter-square-fill"></i></span>
                            <div class="dropdown flex-grow-1">
                                <button
                                    class="btn p-0 border-0 shadow-none w-100 text-start d-flex justify-content-between align-items-center fw-semibold text-dark dropdown-toggle custom-dropdown-btn"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    style="font-size: 0.9rem;">
                                    <span id="selectedRoleText">Semua Role</span>
                                </button>
                                <ul
                                    class="dropdown-menu w-100 border-0 shadow-lg rounded-4 animate-dropdown mt-2 p-2 bg-white">
                                    <li><a class="dropdown-item rounded-3 mb-1 dropdown-role text-dark text-decoration-none py-2"
                                               href="#" data-value="">Semua Role</a></li>
                                        <li><a class="dropdown-item rounded-3 mb-1 dropdown-role text-dark text-decoration-none py-2"
                                                   href="#" data-value="Admin">Admin</a></li>
                                            <li><a class="dropdown-item rounded-3 mb-1 dropdown-role text-dark text-decoration-none py-2"
                                                       href="#" data-value="Staff">Staff</a></li>
                                            </ul>
                                        </div>
                                        <input type="hidden" id="hiddenRole" value="">
                                    </div>
                                </div>

                                <!-- Search Bar & Tombol Cari -->
                                <div class="col-12 col-lg-8">
                                    <div class="input-group bg-light rounded-pill px-3 py-1 border shadow-sm align-items-center">
                                        <span class="text-muted me-2"><i class="bi bi-search"></i></span>
                                        <input type="text" id="searchString"
                                               class="form-control bg-transparent border-0 shadow-none text-dark"
                                               style="font-size: 0.9rem;" placeholder="Cari username, nama lengkap, atau email...">
                                        <button type="submit"
                                                class="btn btn-pertamina-red rounded-pill px-3 px-md-4 py-2 btn-sm fw-bold text-white shadow-sm ms-1 text-nowrap">
                                            Cari
                                        </button>
                                        <button type="button" id="btnResetFilter"
                                                class="btn btn-light rounded-pill px-2 px-md-3 py-2 btn-sm fw-semibold border text-dark shadow-sm ms-1 text-nowrap d-none">
                                            Batal
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </form>

                        <!-- TABEL DATA -->
                        <div class="table-responsive user-table-responsive">
                            <table class="table table-hover align-middle mb-0 user-management-table" style="font-size: 0.85rem;">
                                <thead class="table-light text-uppercase small text-nowrap">
                                    <tr>
                                        <th class="text-center py-3" style="width: 50px;">No</th>
                                        <th class="py-3">Username</th>
                                        <th class="py-3">Nama Lengkap</th>
                                        <th class="py-3">Email</th>
                                        <th class="text-center py-3">Role / Hak Akses</th>
                                        <th class="text-center py-3" style="width: 140px;">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="userTableBody">
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <span class="spinner-border spinner-border-sm me-2"></span>Memuat data pengguna...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>

            @section Scripts {
                <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css">
                <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

                <script>
                    window.API_BASE_URL = '@apiBaseUrl';

                    document.addEventListener("DOMContentLoaded", function () {
                    loadUserData();

                    // Script Dropdown Role selection
                    const dropdownItems = document.querySelectorAll('.dropdown-role');
                    const selectedText = document.getElementById('selectedRoleText');
                    const hiddenRoleInput = document.getElementById('hiddenRole');

                    dropdownItems.forEach(item => {
                    item.addEventListener('click', function (e) {
                    e.preventDefault();
                    const value = this.getAttribute('data-value');
                    const text = this.textContent;

                    selectedText.textContent = text;
                    hiddenRoleInput.value = value;
                    loadUserData();
                    });
                    });

                    // Handle Filter Form Submit
                    document.getElementById('filterForm').addEventListener('submit', function (e) {
                    e.preventDefault();
                    loadUserData();
                    });

                    // Handle Reset Filter Button
                    document.getElementById('btnResetFilter').addEventListener('click', function () {
                    document.getElementById('searchString').value = '';
                    document.getElementById('hiddenRole').value = '';
                    document.getElementById('selectedRoleText').textContent = 'Semua Role';
                    loadUserData();
                    });
                    });

                    async function loadUserData() {
                    const searchString = document.getElementById('searchString').value.trim();
                    const roleFilter = document.getElementById('hiddenRole').value;

                    // Toggle Reset Button visibility
                    const resetBtn = document.getElementById('btnResetFilter');
                    if (searchString || roleFilter) {
                    resetBtn.classList.remove('d-none');
                    } else {
                    resetBtn.classList.add('d-none');
                    }

                    const params = new URLSearchParams();
                    if (searchString) params.append('searchString', searchString);
                    if (roleFilter) params.append('roleFilter', roleFilter);

                    try {
                    const response = await fetch(`${window.API_BASE_URL}/api/user?${params.toString()}`, {
                    method: 'GET',
                    credentials: 'include'
                    });

                    if (response.status === 401) {
                    window.location.href = '/Auth/Login';
                    return;
                    }

                    const resJson = await response.json();
                    const items = Array.isArray(resJson) ? resJson : (resJson.data || resJson.users || []);

                    const tbody = document.getElementById('userTableBody');
                    tbody.innerHTML = '';

                    if (!items || items.length === 0) {
                    tbody.innerHTML = `
                    <tr>
                    <td colspan="6" class="text-center text-muted py-4 fst-italic">Belum ada data pengguna yang tercatat.</td>
                    </tr>`;
                    return;
                    }

                    items.forEach((item, index) => {
                    const id = Number(item.id || item.Id || 0);
                    const rawUsername = item.username || item.Username || '-';
                    const username = window.escapeHtml(rawUsername);
                    const namaLengkap = window.escapeHtml(item.namaLengkap || item.NamaLengkap || '-');
                    const email = window.escapeHtml(item.email || item.Email || '-');
                    const rawRole = item.role || item.Role || '-';
                    const role = window.escapeHtml(rawRole);

                    let badgeRole = '';
                    if (rawRole === 'Admin') {
                    badgeRole = `<span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.75rem;">Admin</span>`;
                    } else {
                    badgeRole = `<span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.75rem;">${role}</span>`;
                    }

                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                    <td data-label="No" class="text-center fw-semibold text-muted">${index + 1}</td>
                    <td data-label="Username" class="fw-bold text-dark text-break">${username}</td>
                    <td data-label="Nama lengkap" class="text-muted text-break">${namaLengkap}</td>
                    <td data-label="Email" class="text-muted text-break">${email}</td>
                    <td data-label="Role" class="text-center text-nowrap">${badgeRole}</td>
                    <td data-label="Aksi" class="text-center text-nowrap">
                    <div class="d-flex justify-content-center gap-1 align-items-center">
                    <a href="/User/Edit/${id}"
                    class="btn btn-warning btn-sm rounded-pill px-2 py-1 fw-bold shadow-sm text-dark d-inline-flex align-items-center gap-1"
                    style="font-size: 0.75rem;" title="Edit">
                    <i class="bi bi-pencil-square"></i> <span class="d-none d-md-inline">Edit</span>
                    </a>
                    <button type="button"
                    class="btn btn-danger btn-sm rounded-pill px-2 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1 text-white"
                    style="font-size: 0.75rem;"
                    onclick="konfirmasiHapus(${Number(id)}, decodeURIComponent('${encodeURIComponent(rawUsername).replace(/'/g, '%27')}'))" title="Hapus">
                    <i class="bi bi-trash"></i> <span class="d-none d-md-inline">Hapus</span>
                    </button>
                    </div>
                    </td>
                    `;
                    tbody.appendChild(tr);
                    });

                    } catch (error) {
                    console.error('Gagal memuat data pengguna:', error);
                    document.getElementById('userTableBody').innerHTML = `
                    <tr><td colspan="6" class="text-center py-4 text-danger">Gagal terhubung ke server backend.</td></tr>`;
                    }
                    }

                    async function konfirmasiHapus(userId, username) {
                    const confirmResult = await Swal.fire({
                    title: 'Yakin Ingin Menghapus?',
                    text: `Pengguna "${username}" akan dihapus secara permanen dari sistem.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ED1B24',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Ya, Hapus',
                    cancelButtonText: 'Batal',
                    customClass: {
                    popup: 'rounded-4 shadow-lg'
                    }
                    });

                    if (!confirmResult.isConfirmed) return;

                    try {
                    const response = await fetch(`${window.API_BASE_URL}/api/user/${userId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                    });

                    const resJson = await response.json().catch(() => ({ success: response.ok }));

                    if (response.ok && (resJson.success !== false)) {
                    Swal.fire({
                    title: 'Terhapus!',
                    text: resJson.message || 'Pengguna berhasil dihapus.',
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false,
                    customClass: { popup: 'rounded-4 shadow-lg' }
                    });
                    loadUserData();
                    } else {
                    Swal.fire('Gagal!', resJson.message || 'Gagal menghapus pengguna.', 'error');
                    }
                    } catch (error) {
                    Swal.fire('Gagal!', 'Tidak dapat terhubung ke server backend.', 'error');
                    }
                    }
                </script>
            }
