@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var apiBaseUrl = "";
    ViewData["Title"] = "Hapus Peminjaman - SIGMA";
}

<!-- STYLE KHUSUS HALAMAN INI -->
<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeInUp 0.4s ease-out forwards;
    }

    .bg-pertamina-blue {
        background-color: #003876 !important;
    }
</style>

<!-- KONTEN UTAMA -->
<div class="container py-4 py-md-5 animate-fade-in d-flex justify-content-center px-3">
    <div class="card border-0 shadow-sm rounded-4 w-100 bg-white" style="max-width: 650px;">
        <div class="card-body p-4 p-md-5 text-center">

            <div class="mb-3">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center mx-auto"
                     style="width: 70px; height: 70px;">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                </div>
            </div>

            <h4 class="fw-bold text-dark mb-2 fs-5 fs-md-4">Konfirmasi Hapus Peminjaman</h4>
            <p class="text-muted small mb-4" style="font-size: 0.85rem;">
                Apakah Anda yakin ingin menghapus data peminjaman ini? Tindakan ini tidak dapat dibatalkan.
            </p>

            <div class="bg-light rounded-4 p-3 p-md-4 text-start mb-4 border" style="font-size: 0.85rem;">
                <div class="row mb-2 align-items-center">
                    <div class="col-5 col-sm-4 text-muted fw-semibold text-nowrap">Nama Peminjam</div>
                    <div class="col-7 col-sm-8 fw-bold text-dark" id="lblNamaPeminjam">Memuat...</div>
                </div>
                <div class="row mb-2 align-items-center">
                    <div class="col-5 col-sm-4 text-muted fw-semibold text-nowrap">Perangkat</div>
                    <div class="col-7 col-sm-8 fw-semibold text-dark" id="lblPerangkat">Memuat...</div>
                </div>
                <div class="row mb-2 align-items-center">
                    <div class="col-5 col-sm-4 text-muted fw-semibold text-nowrap">Jumlah</div>
                    <div class="col-7 col-sm-8 text-dark" id="lblJumlah">Memuat...</div>
                </div>
                <div class="row mb-2 align-items-center">
                    <div class="col-5 col-sm-4 text-muted fw-semibold text-nowrap">Tanggal Pinjam</div>
                    <div class="col-7 col-sm-8 text-dark" id="lblTanggalPinjam">Memuat...</div>
                </div>
                <div class="row mb-2 align-items-center">
                    <div class="col-5 col-sm-4 text-muted fw-semibold text-nowrap">Status</div>
                    <div class="col-7 col-sm-8" id="lblStatus">
                        <span class="badge bg-secondary px-2.5 py-1 rounded-pill fw-semibold"
                              style="font-size: 0.75rem;">Memuat...</span>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-5 col-sm-4 text-muted fw-semibold text-nowrap">Keterangan</div>
                    <div class="col-7 col-sm-8 text-secondary" id="lblKeterangan">Memuat...</div>
                </div>
            </div>

            <form id="formHapusPeminjaman">
                <input type="hidden" id="peminjamanId" />

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a href="/Peminjaman/Index"
                       class="btn btn-light border rounded-pill px-4 py-2 fw-semibold text-dark shadow-sm"
                       style="font-size: 0.85rem;">Batalkan</a>
                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm text-nowrap"
                            style="font-size: 0.85rem;">
                        <i class="bi bi-trash-fill me-1"></i> Ya, Hapus Data
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css">
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

    <script>
        window.API_BASE_URL = '@apiBaseUrl';

        document.addEventListener("DOMContentLoaded", function () {
        // Ambil ID dari URL path (misal: /Peminjaman/Delete/5 -> ID = 5)
        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        const id = pathSegments[pathSegments.length - 1];

        if (!id || isNaN(id)) {
        Swal.fire('Error', 'ID Peminjaman tidak valid.', 'error').then(() => {
        window.location.href = '/Peminjaman/Index';
        });
        return;
        }

        document.getElementById('peminjamanId').value = id;
        loadPeminjamanDetail(id);

        // Handle Submit Delete
        document.getElementById('formHapusPeminjaman').addEventListener('submit', async function (e) {
        e.preventDefault();

        const confirmResult = await Swal.fire({
        title: 'Konfirmasi Penghapusan',
        text: 'Apakah Anda yakin ingin menghapus data peminjaman ini secara permanen?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ED1B24',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Ya, Hapus',
        cancelButtonText: 'Batal',
        customClass: { popup: 'rounded-4 shadow-lg' }
        });

        if (!confirmResult.isConfirmed) return;

        try {
        const response = await fetch(`${window.API_BASE_URL}/api/peminjaman/${id}`, {
        method: 'DELETE',
        credentials: 'include'
        });

        if (response.status === 401) {
        window.location.href = '/Auth/Login';
        return;
        }

        const result = await response.json().catch(() => ({ success: response.ok }));

        if (response.ok && (result.success !== false)) {
        Swal.fire({
        title: 'Terhapus!',
        text: result.message || 'Data peminjaman berhasil dihapus.',
        icon: 'success',
        timer: 1500,
        showConfirmButton: false,
        customClass: { popup: 'rounded-4 shadow-lg' }
        }).then(() => {
        window.location.href = '/Peminjaman/Index';
        });
        } else {
        Swal.fire('Gagal!', result.message || 'Gagal menghapus data peminjaman.', 'error');
        }
        } catch (error) {
        Swal.fire('Gagal!', 'Tidak dapat terhubung ke server backend.', 'error');
        }
        });
        });

        async function loadPeminjamanDetail(id) {
        try {
        const response = await fetch(`${window.API_BASE_URL}/api/peminjaman/${id}`, {
        method: 'GET',
        credentials: 'include'
        });

        if (response.status === 401) {
        window.location.href = '/Auth/Login';
        return;
        }

        if (!response.ok) {
        Swal.fire('Gagal', 'Data peminjaman tidak ditemukan.', 'error').then(() => {
        window.location.href = '/Peminjaman/Index';
        });
        return;
        }

        const resJson = await response.json();
        const item = resJson.data || resJson;

        const namaPeminjam = item.namaPeminjam || item.NamaPeminjam || '-';
        const perangkatNama = item.perangkat?.nama || item.Perangkat?.Nama || '-';
        const jumlah = item.jumlah || item.Jumlah || 0;
        const tanggalPinjam = item.tanggalPinjam || item.TanggalPinjam ? new Date(item.tanggalPinjam || item.TanggalPinjam).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
        const status = item.status || item.Status || 'Pending';
        const keterangan = item.keterangan || item.Keterangan || '-';

        document.getElementById('lblNamaPeminjam').innerText = namaPeminjam;
        document.getElementById('lblPerangkat').innerText = perangkatNama;
        document.getElementById('lblJumlah').innerText = `${jumlah} Unit`;
        document.getElementById('lblTanggalPinjam').innerText = tanggalPinjam;
        document.getElementById('lblKeterangan').innerText = keterangan;

        // Badge Status
        let badgeHtml = '';
        if (status === 'Disetujui') {
        badgeHtml = `<span class="badge bg-success px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">Disetujui</span>`;
        } else if (status === 'Ditolak') {
        badgeHtml = `<span class="badge bg-danger px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">Ditolak</span>`;
        } else {
        badgeHtml = `<span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">Menunggu Verifikasi</span>`;
        }
        document.getElementById('lblStatus').innerHTML = badgeHtml;

        } catch (error) {
        console.error('Gagal mengambil detail peminjaman:', error);
        Swal.fire('Error', 'Gagal memuat data dari server backend.', 'error');
        }
        }
    </script>
}