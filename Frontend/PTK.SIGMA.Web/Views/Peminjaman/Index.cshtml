@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var apiBaseUrl = "";
    ViewData["Title"] = "Kelola Peminjaman - SIGMA";
}

<!-- STYLE KHUSUS HALAMAN INI -->
<style>
    .animate-fade-in {
        animation: fadeInUp 0.4s ease-out forwards;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .bg-pertamina-red {
        background-color: #ED1B24 !important;
    }

    .text-pertamina-red {
        color: #ED1B24 !important;
    }

    .btn-pertamina-red {
        background-color: #ED1B24;
        color: white;
        border: none;
    }

    .btn-pertamina-red:hover {
        background-color: #d0121a;
        color: white;
    }

    .bg-pertamina-blue {
        background-color: #003876 !important;
    }

    .btn-pertamina-blue {
        background-color: #003876;
        color: white;
        border: none;
    }

    .btn-pertamina-blue:hover {
        background-color: #002b5c;
        color: white;
    }

    .form-control:focus {
        border-color: #003876 !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 56, 118, 0.15) !important;
    }

    /* --- STYLE UNTUK CUSTOM DROPDOWN KATEGORI --- */
    .custom-dropdown-container {
        position: relative;
        width: 100%;
    }

    .custom-select-input {
        cursor: pointer;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.45rem 1rem;
        border-radius: 50rem;
        font-weight: 500;
        color: #212529;
        transition: all 0.2s ease;
    }

    .custom-select-input:hover,
    .custom-select-input.active {
        border-color: #003876;
        box-shadow: 0 0 0 0.2rem rgba(0, 56, 118, 0.15);
        background-color: white;
    }

    .custom-dropdown-list {
        position: absolute;
        z-index: 1050;
        width: 100%;
        max-height: 300px;
        overflow-y: auto;
        display: none;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        margin-top: 8px;
        border: 1px solid #dcdcdc;
        padding: 10px 0;
    }

    .dropdown-item-custom {
        cursor: pointer;
        padding: 8px 20px;
        color: #333;
        transition: all 0.2s ease;
    }

    .dropdown-item-custom:hover {
        background-color: #e6f0fa;
        color: #003876;
    }
</style>

<!-- KONTEN UTAMA -->
<div class="container py-3 py-md-4 px-2 px-md-4 animate-fade-in" style="max-width: 1350px;">

    <!-- CARD ATAS: JUDUL & TOMBOL TAMBAH -->
    <div class="card border-0 shadow-sm rounded-4 mb-3 bg-white">
        <div
            class="card-body p-3 p-md-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                     style="width: 45px; height: 45px;">
                    <i class="bi bi-clock-history text-primary fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark m-0 fs-6 fs-md-5">Sirkulasi Peminjaman</h5>
                    <p class="text-muted small m-0 mt-1" style="font-size: 0.8rem;">
                        Daftar pengajuan dan sirkulasi peminjaman perangkat.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row align-items-stretch gap-2">
                <a href="/Home/Index"
                   class="btn btn-light border rounded-pill px-3 py-2 fw-semibold text-dark shadow-sm text-center"
                   style="font-size: 0.85rem;">
                    Kembali
                </a>
                <a href="/Peminjaman/Create"
                   class="btn btn-pertamina-red rounded-pill px-3 py-2 fw-semibold shadow-sm text-center text-nowrap"
                   style="font-size: 0.85rem;">
                    <i class="bi bi-plus-lg me-1"></i> Tambah Peminjaman
                </a>
            </div>
        </div>
    </div>

    <!-- CARD BAWAH: FILTER, PENCARIAN & TABEL -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-5">
        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column gap-3 mb-3 sigma-filter-panel loan-filter-panel">
                <h6 class="fw-bold m-0 text-dark text-uppercase tracking-wider"
                    style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    Daftar Riwayat & Pengajuan Masuk
                </h6>

                <!-- FORM PENCARIAN & FILTER -->
                <form id="filterForm" class="row g-2 align-items-end">

                    <!-- Input Cari -->
                    <div class="col-12 col-md-3">
                        <label class="form-label text-muted small fw-semibold mb-1" style="font-size: 0.75rem;">Cari
                            Perangkat / Peminjam</label>
                            <div class="input-group bg-light rounded-pill px-3 py-1 border shadow-sm align-items-center">
                                <span class="text-muted me-2"><i class="bi bi-search"></i></span>
                                <input type="text" id="searchString" name="searchString"
                                       class="form-control bg-transparent border-0 shadow-none text-dark"
                                       style="font-size: 0.8rem;" placeholder="Cari nama...">
                            </div>
                        </div>

                        <!-- Tanggal Mulai -->
                        <div class="col-6 col-md-2 loan-date-filter">
                            <label class="form-label text-muted small fw-semibold mb-1" style="font-size: 0.75rem;">Dari
                                Tanggal</label>
                                <input type="date" id="startDate" name="startDate"
                                       class="form-control rounded-pill bg-light border shadow-sm text-dark"
                                       style="font-size: 0.8rem;">
                            </div>

                            <!-- Tanggal Selesai -->
                            <div class="col-6 col-md-2 loan-date-filter">
                                <label class="form-label text-muted small fw-semibold mb-1" style="font-size: 0.75rem;">Sampai
                                    Tanggal</label>
                                    <input type="date" id="endDate" name="endDate"
                                           class="form-control rounded-pill bg-light border shadow-sm text-dark"
                                           style="font-size: 0.8rem;">
                                </div>

                                <!-- CUSTOM DROPDOWN KATEGORI (DINAMIS) -->
                                <div class="col-12 col-md-2">
                                    <label class="form-label text-muted small fw-semibold mb-1" style="font-size: 0.75rem;">Kategori
                                        Barang</label>
                                        <div class="custom-dropdown-container">
                                            <div class="custom-select-input shadow-sm bg-light border" id="kategoriSelectBox"
                                                 onclick="toggleKategoriDropdown()" style="font-size: 0.8rem;">
                                                <span id="kategoriSelectedText">Semua Kategori</span>
                                                <i class="bi bi-chevron-down"></i>
                                            </div>
                                            <input type="hidden" name="kategori" id="filterKategoriValue" value="">
                                            <div class="custom-dropdown-list shadow-lg" id="kategoriDropdownList"
                                                 style="font-size: 0.8rem;">
                                                <div class="dropdown-item-custom fw-semibold"
                                                     onclick="selectKategori('', 'Semua Kategori')">Semua Kategori</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-3 d-flex gap-2 mt-2 mt-md-0 loan-filter-actions">
                                        <button type="submit"
                                                class="btn btn-pertamina-red rounded-pill px-3 btn-sm fw-bold text-white shadow-sm w-100"
                                                style="font-size: 0.8rem;" title="Filter Data">
                                            <i class="bi bi-funnel-fill"></i> Filter
                                        </button>

                                        <button type="button" id="btnDownloadPdf"
                                                class="btn btn-danger rounded-pill btn-sm fw-semibold shadow-sm w-100 text-nowrap"
                                                style="font-size: 0.75rem;" title="Download PDF">
                                            <i class="bi bi-file-pdf"></i> Download PDF
                                        </button>

                                        <button type="button" id="btnResetFilter"
                                                class="btn btn-light rounded-pill px-2 btn-sm fw-semibold border text-dark shadow-sm text-center d-none"
                                                style="font-size: 0.75rem;" title="Reset Filter">
                                            <i class="bi bi-x-lg"></i> Reset Filter
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <div class="table-responsive mt-3">
                                <table class="table table-hover align-middle mb-0 sigma-loan-table" style="font-size: 0.85rem;">
                                    <thead class="table-light text-uppercase">
                                        <tr>
                                            <th class="text-center py-3">No</th>
                                            <th class="py-3">Nama Peminjam</th>
                                            <th class="py-3">No. BA</th>
                                            <th class="py-3">Perangkat</th>
                                            <th class="py-3">Lokasi Barang</th>
                                            <th class="text-center py-3">Jumlah</th>
                                            <th class="py-3">Tanggal Pinjam</th>
                                            <th class="py-3">Tanggal Kembali</th>
                                            <th class="text-center py-3">Status Persetujuan Admin</th>
                                            <th class="text-center py-3">Status Peminjaman</th>
                                            <th class="py-3">Keterangan</th>
                                            <th class="text-center py-3" style="min-width: 160px;">Aksi / Verifikasi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="peminjamanTableBody">
                                        <tr>
                                            <td colspan="12" class="text-center py-4 text-muted">
                                                <span class="spinner-border spinner-border-sm me-2"></span>Memuat data peminjaman...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- NAVIGASI PAGINATION -->
                            <nav class="d-flex justify-content-center mt-4" id="paginationContainer"></nav>

                        </div>
                    </div>
                </div>

                @section Scripts {
                    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css">
                    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

                    <script>
                        window.API_BASE_URL = '@apiBaseUrl';
                        let currentPage = 1;
                        let currentUserRole = '';
                        let namaPerangkatById = new Map();

                        document.addEventListener("DOMContentLoaded", function () {
                            // Ambil info role user terlebih dahulu sebelum memuat data peminjaman
                            fetch(`${window.API_BASE_URL}/api/home/user-info`, {
                                method: 'GET',
                                credentials: 'include'
                            })
                                .then(response => response.ok ? response.json() : null)
                                .then(res => {
                                    if (res && res.success) {
                                        currentUserRole = res.role || '';
                                    }
                                    loadPeminjamanData();
                                    loadKategoriOptions();
                                })
                                .catch(() => {
                                    loadPeminjamanData();
                                    loadKategoriOptions();
                                });

                            // Handle Filter Form Submit
                            document.getElementById('filterForm').addEventListener('submit', function (e) {
                                e.preventDefault();
                                currentPage = 1;
                                loadPeminjamanData();
                            });

                            // Handle Reset Filter
                            document.getElementById('btnResetFilter')?.addEventListener('click', function () {
                                document.getElementById('searchString').value = '';
                                document.getElementById('startDate').value = '';
                                document.getElementById('endDate').value = '';
                                selectKategori('', 'Semua Kategori');
                                currentPage = 1;
                                loadPeminjamanData();
                            });

                            // Handle Download PDF
                            document.getElementById('btnDownloadPdf').addEventListener('click', function () {
                                const startDate = document.getElementById('startDate').value;
                                const endDate = document.getElementById('endDate').value;
                                let url = `${window.API_BASE_URL}/api/peminjaman/download-pdf`;
                                const params = [];
                                if (startDate) params.push(`startDate=${startDate}`);
                                if (endDate) params.push(`endDate=${endDate}`);
                                if (params.length > 0) url += `?${params.join('&')}`;

                                window.open(url, '_blank');
                            });
                        });

                        // Load kategori options for filter dropdown
                        async function loadKategoriOptions() {
                            try {
                                const response = await fetch(`${window.API_BASE_URL}/api/peminjaman/create-options`, { credentials: 'include' });
                                if (response.ok) {
                                    const resJson = await response.json();
                                    const options = resJson.options || resJson.data || resJson;
                                    const katList = options.kategoriList || options.KategoriList || [];
                                    const perangkatList = options.perangkatList || options.PerangkatList || [];
                                    namaPerangkatById = new Map(perangkatList.map(p => [
                                        String(p.id || p.Id),
                                        p.nama || p.Nama || '-'
                                    ]));
                                    const dropdownList = document.getElementById('kategoriDropdownList');

                                    let html = `<div class="dropdown-item-custom fw-semibold" onclick="selectKategori('', 'Semua Kategori')">Semua Kategori</div>`;
                                    katList.forEach(kat => {
                                        const encoded = encodeURIComponent(String(kat ?? '')).replace(/'/g, '%27');
                                        html += `<div class="dropdown-item-custom" onclick="selectKategori(decodeURIComponent('${encoded}'), decodeURIComponent('${encoded}'))">${window.escapeHtml(kat)}</div>`;
                                    });
                                    dropdownList.innerHTML = html;
                                }
                            } catch (err) {
                                console.error('Gagal memuat kategori:', err);
                            }
                        }

                        // Load Peminjaman Data via API
                        async function loadPeminjamanData(page = 1) {
                            currentPage = page;
                            const searchString = document.getElementById('searchString').value.trim();
                            const startDate = document.getElementById('startDate').value;
                            const endDate = document.getElementById('endDate').value;
                            const kategori = document.getElementById('filterKategoriValue').value;

                            // Toggle Reset Filter button visibility
                            const hasFilter = searchString || startDate || endDate || kategori;
                            const resetBtn = document.getElementById('btnResetFilter');
                            if (resetBtn) {
                                if (hasFilter) resetBtn.classList.remove('d-none');
                                else resetBtn.classList.add('d-none');
                            }

                            const params = new URLSearchParams({ page: currentPage });
                            if (searchString) params.append('searchString', searchString);
                            if (startDate) params.append('startDate', startDate);
                            if (endDate) params.append('endDate', endDate);
                            if (kategori) params.append('kategori', kategori);

                            try {
                                const response = await fetch(`${window.API_BASE_URL}/api/peminjaman?${params.toString()}`, {
                                    method: 'GET',
                                    credentials: 'include'
                                });

                                if (response.status === 401) {
                                    window.location.href = '/Auth/Login';
                                    return;
                                }

                                const resJson = await response.json();
                                const result = resJson.data || resJson;

                                const items = Array.isArray(result) ? result : (result.items || result.peminjamanList || result.data || []);
                                const totalPages = result.totalPages || result.TotalPages || 1;
                                const tbody = document.getElementById('peminjamanTableBody');
                                tbody.innerHTML = '';

                                if (!items || items.length === 0) {
                                    tbody.innerHTML = `
                                                                <tr>
                                                                    <td colspan="12" class="text-center text-muted py-4">Belum ada riwayat atau pengajuan peminjaman tercatat.</td>
                                                                </tr>`;
                                    document.getElementById('paginationContainer').innerHTML = '';
                                    return;
                                }

                                items.forEach((item, index) => {
                                    const id = Number(item.id || item.Id || 0);
                                    const namaPeminjam = window.escapeHtml(item.namaPeminjam || item.NamaPeminjam || '-');
                                    const noBa = window.escapeHtml(item.noBa || item.NoBa || '-');
                                    const perangkatId = item.perangkatId || item.PerangkatId;
                                    const perangkatNama = window.escapeHtml(item.perangkat?.nama
                                        || item.Perangkat?.Nama
                                        || item.namaPerangkat
                                        || item.NamaPerangkat
                                        || item.perangkatNama
                                        || item.PerangkatNama
                                        || namaPerangkatById.get(String(perangkatId))
                                        || '-');
                                    const lokasiNama = window.escapeHtml(item.namaLokasi || item.NamaLokasi || item.lokasi?.namaLokasi || item.Lokasi?.NamaLokasi || '-');
                                    const jumlah = Number(item.jumlah || item.Jumlah || 0);
                                    const tglPinjam = item.tanggalPinjam || item.TanggalPinjam ? new Date(item.tanggalPinjam || item.TanggalPinjam).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';

                                    const rawTglKembali = item.tanggalKembali || item.TanggalKembali || item.tglKembali || item.TglKembali;
                                    // Pengecekan apakah tanggal kembali valid dan bukan default
                                    const isTglKembaliValid = rawTglKembali && !rawTglKembali.startsWith("0001");
                                    const tglKembali = isTglKembaliValid ? new Date(rawTglKembali).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';

                                    const status = item.status || item.Status || 'Pending';
                                    const statusPeminjaman = item.statusPeminjaman || item.StatusPeminjaman || 'Dipinjam';
                                    const keterangan = window.escapeHtml(item.keterangan || item.Keterangan || '-');

                                    // Badge Status Persetujuan
                                    let badgeStatus = '';
                                    if (status === 'Disetujui') {
                                        badgeStatus = `<span class="badge bg-success px-2.5 py-1.5 rounded-pill fw-semibold">Disetujui</span>`;
                                    } else if (status === 'Ditolak') {
                                        badgeStatus = `<span class="badge bg-danger px-2.5 py-1.5 rounded-pill fw-semibold">Ditolak</span>`;
                                    } else {
                                        badgeStatus = `<span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill fw-semibold">Menunggu Verifikasi</span>`;
                                    }

                                    // Badge Status Fisik / Keterlambatan
                                    let badgeFisik = '';
                                    const isTerlambat = status === 'Disetujui' && isTglKembaliValid && new Date().setHours(0, 0, 0, 0) > new Date(rawTglKembali).setHours(0, 0, 0, 0);

                                    if (statusPeminjaman === 'Dikembalikan') {
                                        badgeFisik = `<span class="badge bg-secondary px-2.5 py-1.5 rounded-pill fw-semibold">Dikembalikan</span>`;
                                    } else if (statusPeminjaman === 'Dikeluarkan') {
                                        badgeFisik = `<span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill fw-semibold">Dikeluarkan</span>`;
                                    } else if (isTerlambat) {
                                        badgeFisik = `<span class="badge bg-danger px-2.5 py-1.5 rounded-pill fw-semibold shadow-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i> Terlambat</span>`;
                                    } else {
                                        badgeFisik = `<span class="badge bg-info text-dark px-2.5 py-1.5 rounded-pill fw-semibold">Dipinjam</span>`;
                                    }

                                    // =========================================================================
                                    // PERBAIKAN: Pengecekan Role & Status untuk Tombol Aksi (Admin vs Staff)
                                    // =========================================================================
                                    let isAdmin = currentUserRole.toLowerCase() === 'admin';
                                    let actionButtons = '';

                                    // Jika status masih Menunggu Verifikasi / Pending
                                    if (status === 'Pending' || status === 'Menunggu Verifikasi' || !status) {
                                        if (isAdmin) {
                                            actionButtons = `
                                                                        <div class="d-flex justify-content-center gap-1">
                                                                            <button type="button" class="btn btn-success btn-sm px-2.5 py-1.5 rounded-3 fw-semibold shadow-sm text-nowrap" style="font-size: 0.75rem;" onclick="aksiPeminjaman(${id}, 'setujui', 'Setujui pengajuan ini?')">
                                                                                <i class="bi bi-check-lg me-1"></i> Setujui
                                                                            </button>
                                                                            <button type="button" class="btn btn-danger btn-sm px-2.5 py-1.5 rounded-3 fw-semibold shadow-sm text-nowrap" style="font-size: 0.75rem;" onclick="aksiPeminjaman(${id}, 'tolak', 'Tolak pengajuan ini?')">
                                                                                <i class="bi bi-x-lg me-1"></i> Tolak
                                                                            </button>
                                                                        </div>`;
                                        } else {
                                            actionButtons = `<span class="text-muted small">-</span>`;
                                        }
                                    } else {
                                        // Tombol Kembalikan: Ditambahkan syarat isTglKembaliValid (Mencegah tombol muncul jika tanggal kosong)
                                        let kembalikanBtn = '';
                                        if (status === 'Disetujui' && statusPeminjaman === 'Dipinjam' && isTglKembaliValid) {
                                            kembalikanBtn = `
                                                                        <button type="button" class="btn btn-secondary btn-sm w-100 py-1 rounded-3 fw-semibold shadow-sm text-nowrap mb-1" style="font-size: 0.75rem;" onclick="aksiPeminjaman(${id}, 'kembalikan', 'Tandai sudah dikembalikan?')">
                                                                            <i class="bi bi-arrow-return-left me-1"></i> Dikembalikan
                                                                        </button>`;
                                        }

                                        let printButton = '';
                                        if (status === 'Disetujui') {
                                            printButton = `
                                                                        <a href="/Peminjaman/PrintBa?id=${id}" target="_blank" class="btn btn-outline-dark btn-sm rounded-3 px-2.5 py-1 fw-semibold shadow-sm flex-fill text-center" style="font-size: 0.75rem;" title="Cetak Berita Acara" onclick="cetakBA(event, ${id})">
                                                                            <i class="bi bi-printer"></i>
                                                                        </a>`;
                                        }

                                        // Jika Admin: Muncul Kembalikan, Edit, Hapus, dan Print (Icon)
                                        if (isAdmin) {
                                            actionButtons = `
                                                                        <div class="d-flex flex-column gap-1 align-items-center justify-content-center">
                                                                            ${kembalikanBtn}
                                                                            <div class="d-flex justify-content-center gap-1 w-100">
                                                                                <a href="/Peminjaman/Edit?id=${id}" class="btn btn-outline-warning btn-sm rounded-3 px-2 py-1 fw-semibold shadow-sm flex-fill text-center" style="font-size: 0.75rem;" title="Edit">
                                                                                    <i class="bi bi-pencil-square"></i>
                                                                                </a>
                                                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1 fw-semibold shadow-sm flex-fill text-center" style="font-size: 0.75rem;" title="Hapus" onclick="hapusPeminjaman(${id})">
                                                                                    <i class="bi bi-trash"></i>
                                                                                </button>
                                                                                ${printButton}
                                                                            </div>
                                                                        </div>`;
                                        }
                                        // Jika Staff: HANYA Muncul Kembalikan & Print (Teks lengkap)
                                        else {
                                            if (status === 'Disetujui') {
                                                actionButtons = `
                                                                            <div class="d-flex flex-column gap-1 align-items-center justify-content-center w-100">
                                                                                ${kembalikanBtn}
                                                                                <a href="/Peminjaman/PrintBa?id=${id}" target="_blank" class="btn btn-outline-dark btn-sm rounded-3 px-2.5 py-1.5 fw-semibold shadow-sm text-center w-100" style="font-size: 0.75rem;" title="Cetak Berita Acara" onclick="cetakBA(event, ${id})">
                                                                                    <i class="bi bi-printer"></i> Cetak BA
                                                                                </a>
                                                                            </div>`;
                                            } else {
                                                actionButtons = `<span class="text-muted small">-</span>`;
                                            }
                                        }
                                    }

                                    const tr = document.createElement('tr');
                                    tr.innerHTML = `
                                                                <td class="text-center fw-semibold text-muted">${(currentPage - 1) * 10 + index + 1}</td>
                                                                <td class="fw-bold text-dark">${namaPeminjam}</td>
                                                                <td><span class="badge bg-light text-dark border px-2 py-1">${noBa}</span></td>
                                                                <td>${perangkatNama}</td>
                                                                <td><span class="text-dark">${lokasiNama}</span></td>
                                                                <td class="text-center"><span class="badge bg-secondary">${jumlah} Unit</span></td>
                                                                <td>${tglPinjam}</td>
                                                                <td>${tglKembali}</td>
                                                                <td class="text-center">${badgeStatus}</td>
                                                                <td class="text-center">${badgeFisik}</td>
                                                                <td>${keterangan}</td>
                                                                <td class="text-center">${actionButtons}</td>
                                                            `;
                                    tbody.appendChild(tr);
                                });

                                // Render Pagination
                                renderPagination(totalPages, currentPage);

                            } catch (error) {
                                console.error('Gagal memuat data peminjaman:', error);
                                document.getElementById('peminjamanTableBody').innerHTML = `
                                                            <tr><td colspan="12" class="text-center py-4 text-danger">Gagal terhubung ke server backend.</td></tr>`;
                            }
                        }

                        function renderPagination(totalPages, current) {
                            const container = document.getElementById('paginationContainer');
                            if (totalPages <= 1) {
                                container.innerHTML = '';
                                return;
                            }

                            let html = `<ul class="pagination pagination-sm rounded-pill shadow-sm">`;
                            html += `<li class="page-item ${current === 1 ? 'disabled' : ''}"><a class="page-link rounded-start-pill px-3" href="#" onclick="loadPeminjamanData(${current - 1}); return false;"><i class="bi bi-chevron-left"></i> Prev</a></li>`;

                            for (let i = 1; i <= totalPages; i++) {
                                html += `<li class="page-item ${i === current ? 'active' : ''}"><a class="page-link px-3" href="#" onclick="loadPeminjamanData(${i}); return false;">${i}</a></li>`;
                            }

                            html += `<li class="page-item ${current === totalPages ? 'disabled' : ''}"><a class="page-link rounded-end-pill px-3" href="#" onclick="loadPeminjamanData(${current + 1}); return false;">Next <i class="bi bi-chevron-right"></i></a></li>`;
                            html += `</ul>`;
                            container.innerHTML = html;
                        }

                        // Aksi Peminjaman (Setujui, Tolak, Kembalikan)
                        async function aksiPeminjaman(id, actionType, confirmMessage) {
                            const confirmResult = await Swal.fire({
                                title: 'Konfirmasi',
                                text: confirmMessage,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#ED1B24',
                                cancelButtonColor: '#6c757d',
                                confirmButtonText: 'Ya',
                                cancelButtonText: 'Batal',
                                customClass: { popup: 'rounded-4 shadow-lg' }
                            });

                            if (!confirmResult.isConfirmed) return;

                            try {
                                const response = await fetch(`${window.API_BASE_URL}/api/peminjaman/${id}/${actionType}`, {
                                    method: 'POST',
                                    credentials: 'include'
                                });

                                const resJson = await response.json().catch(() => ({ success: response.ok }));

                                if (response.ok && (resJson.success !== false)) {
                                    Swal.fire({
                                        title: 'Berhasil!',
                                        text: resJson.message || 'Aksi berhasil diproses.',
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false,
                                        customClass: { popup: 'rounded-4 shadow-lg' }
                                    });
                                    loadPeminjamanData(currentPage);
                                } else {
                                    Swal.fire('Gagal!', resJson.message || 'Terjadi kesalahan.', 'error');
                                }
                            } catch (error) {
                                Swal.fire('Gagal!', 'Tidak dapat terhubung ke server backend.', 'error');
                            }
                        }

                        // Hapus Peminjaman
                        async function hapusPeminjaman(id) {
                            const confirmResult = await Swal.fire({
                                title: 'Apakah Anda yakin?',
                                text: 'Data peminjaman ini akan dihapus permanen.',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#ED1B24',
                                cancelButtonColor: '#6c757d',
                                confirmButtonText: 'Ya, Hapus',
                                cancelButtonText: 'Batal',
                                customClass: { popup: 'rounded-4 shadow-lg' }
                            });

                            if (!confirmResult.isConfirmed) return;

                            try {
                                const response = await fetch(`${window.API_BASE_URL}/api/peminjaman/${id}`, {
                                    method: 'DELETE',
                                    credentials: 'include'
                                });

                                const resJson = await response.json().catch(() => ({ success: response.ok }));

                                if (response.ok && (resJson.success !== false)) {
                                    Swal.fire({
                                        title: 'Terhapus!',
                                        text: resJson.message || 'Data berhasil dihapus.',
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false,
                                        customClass: { popup: 'rounded-4 shadow-lg' }
                                    });
                                    loadPeminjamanData(currentPage);
                                } else {
                                    Swal.fire('Gagal!', resJson.message || 'Gagal menghapus data.', 'error');
                                }
                            } catch (error) {
                                Swal.fire('Gagal!', 'Tidak dapat terhubung ke server backend.', 'error');
                            }
                        }

                        // Cetak BA handler
                        function cetakBA(e, id) {
                            e.preventDefault();
                            window.open(`/Peminjaman/PrintBa?id=${id}`, '_blank');
                        }

                        // Custom Dropdown Kategori Logic
                        function toggleKategoriDropdown() {
                            const dropdown = document.getElementById('kategoriDropdownList');
                            const box = document.getElementById('kategoriSelectBox');
                            if (dropdown.style.display === 'block') {
                                dropdown.style.display = 'none';
                                box.classList.remove('active');
                            } else {
                                dropdown.style.display = 'block';
                                box.classList.add('active');
                            }
                        }

                        function selectKategori(value, text) {
                            document.getElementById('kategoriSelectedText').innerText = text;
                            document.getElementById('filterKategoriValue').value = value;
                            document.getElementById('kategoriDropdownList').style.display = 'none';
                            document.getElementById('kategoriSelectBox').classList.remove('active');
                        }

                        document.addEventListener('click', function (e) {
                            if (!e.target.closest('.custom-dropdown-container')) {
                                const dropdown = document.getElementById('kategoriDropdownList');
                                const box = document.getElementById('kategoriSelectBox');
                                if (dropdown) dropdown.style.display = 'none';
                                if (box) box.classList.remove('active');
                            }
                        });
                    </script>
                }
