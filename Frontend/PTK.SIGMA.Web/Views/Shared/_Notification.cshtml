@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var apiBaseUrl = "";
    var backendBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:5052";
}

<!-- PERBAIKAN: style item notifikasi unread (background tint + garis aksen kiri + label "Baru").
     Idealnya style ini dipindahkan ke stylesheet utama, ditaruh di sini dulu supaya langsung terlihat. -->
<style>
    .notif-title-unread {
        font-weight: 800;
        color: #173a5f;
    }

    .notif-title-read {
        font-weight: 650;
        color: #4a6079;
    }

    .notif-badge-new {
        font-size: .58rem;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, #0d6efd, #2b8cff);
        padding: .23rem .52rem;
        border-radius: 999px;
        letter-spacing: .02em;
    }
</style>

<div class="dropdown">
    <!-- PERBAIKAN: Menambahkan position-relative agar badge tidak lari ke ujung layar -->
    <a class="nav-link position-relative dropdown-toggle no-arrow notif-bell-toggle d-flex align-items-center justify-content-center text-white"
       href="#" role="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false"
       id="notifDropdownToggle" title="Notifikasi aktivitas">
        <i class="bi bi-bell-fill"></i>
        <!-- PERBAIKAN: Posisi badge dibuat lebih pas ke dalam agar tidak terpotong tepi layar -->
        <span id="notif-badge" class="position-absolute badge rounded-pill notif-unread-badge d-none"
              style="top: 0; right: -2px; transform: translate(25%, -25%);">0</span>
    </a>

    <div class="dropdown-menu dropdown-menu-end notif-dropdown-menu mt-2" aria-labelledby="notifDropdownToggle">
        <div class="notif-header">
            <div class="notif-header-main">
                <div class="notif-header-icon"><i class="bi bi-bell-fill"></i></div>
                <div>
                    <strong class="notif-header-title">Notifikasi Aktivitas</strong>
                    <span class="notif-header-subtitle">Pembaruan terbaru dari sistem</span>
                </div>
            </div>
            <span id="notif-badge-count" class="notif-count-pill">0 Baru</span>
        </div>

        <!-- CONTAINER -->
        <div id="notif-list-container">
            <div class="text-center py-5 text-muted small">
                <div class="spinner-border spinner-border-sm notif-spinner me-2" role="status"></div>
                Memuat notifikasi...
            </div>
        </div>

        <!-- FOOTER -->
        <div id="notif-footer-action" class="d-none notif-footer justify-content-between align-items-center">
            <!-- MENGUBAH TEKS DAN FUNGSI TOMBOL HAPUS -->
            <button type="button" class="notif-action-btn text-secondary border-0 bg-transparent"
                    onclick="clearReadNotifications()" title="Hapus notifikasi yang sudah dibaca">
                <i class="bi bi-trash3 me-1"></i> Hapus Terbaca
            </button>
            <button type="button" class="notif-action-btn text-primary border-0 bg-transparent"
                    onclick="markAllAsRead()">
                <i class="bi bi-check2-all me-1"></i> Tandai dibaca
            </button>
        </div>
    </div>
</div>

<!-- SCRIPT -->
<script>
    window.API_BASE_URL = '@apiBaseUrl';
    window.BACKEND_BASE_URL = '@backendBaseUrl';

    let notificationItemNames;
    let notificationLastSignature = null;
    let currentActivityLogs = []; // <-- Variabel baru untuk menyimpan data notifikasi saat ini

    async function loadUnreadCount() {
        try {
            const response = await fetch('/api/activitylog/unread-count', { credentials: 'include' });
            if (!response.ok) return null;
            const result = await response.json();
            if (result?.success) {
                const unreadCount = Number(result.unreadCount) || 0;
                updateBadgeCount(unreadCount);
                return unreadCount;
            }
        } catch (error) {
            console.warn('Gagal memuat jumlah notifikasi:', error);
        }
        return null;
    }

    async function replaceNotificationItemIds(logs) {
        if (!Array.isArray(logs)) return logs;

        try {
            if (!notificationItemNames) {
                const response = await fetch('/api/kelolabarang', { credentials: 'include' });
                const result = await response.json();
                const items = Array.isArray(result) ? result : (result.data || []);
                notificationItemNames = new Map(items.map(item => [
                    String(item.id ?? item.Id), item.namaBarang ?? item.NamaBarang
                ]));
            }

            return logs.map(log => {
                const target = log.target ?? log.Target ?? '';
                const detail = log.detail ?? log.Detail ?? '';
                if (!target.toLowerCase().includes('barang')) return log;

                const updatedDetail = detail.replace(/\bID\s*(\d+)\b/gi, (match, id) =>
                    notificationItemNames.get(String(id)) || match);
                return { ...log, detail: updatedDetail, Detail: updatedDetail };
            });
        } catch (error) {
            console.warn('Nama barang pada notifikasi gagal dimuat:', error);
            return logs;
        }
    }

    async function loadActivityLogs() {
        try {
            const response = await fetch('/api/activitylog?limit=25', { credentials: 'include' });
            if (!response.ok) return null;
            const result = await response.json();
            const logs = Array.isArray(result) ? result : (result.data || []);
            
            currentActivityLogs = logs; // <-- Simpan log ke variabel untuk difilter nanti saat dihapus

            const displayLogs = await replaceNotificationItemIds(logs);
            renderNotificationList(displayLogs);
            return logs;
        } catch (error) {
            console.warn('Gagal memuat log aktivitas:', error);
        }
        return null;
    }

    function getNotificationSignature(logs, unreadCount) {
        const latest = Array.isArray(logs) && logs.length ? logs[0] : null;
        const latestId = latest?.id ?? latest?.Id ?? 0;
        const latestTime = latest?.waktu ?? latest?.Waktu ?? '';
        return `${latestId}|${latestTime}|${Number(unreadCount) || 0}|${logs?.length || 0}`;
    }

    async function refreshNotificationState(notifyPageOnChange = false) {
        const [unreadCount, logs] = await Promise.all([loadUnreadCount(), loadActivityLogs()]);
        if (unreadCount === null || logs === null) return false;

        const signature = getNotificationSignature(logs, unreadCount);
        const changed = notificationLastSignature !== null && notificationLastSignature !== signature;
        notificationLastSignature = signature;

        if (changed && notifyPageOnChange) {
            window.dispatchEvent(new CustomEvent('sigma:notification'));
        }
        return changed;
    }

    window.refreshSigmaNotifications = () => refreshNotificationState(true);

    function updateBadgeCount(count) {
        const badge = document.getElementById('notifUnreadBadge') || document.getElementById('notif-badge');
        const header = document.getElementById('notifHeaderCount') || document.getElementById('notif-badge-count');
        const total = Number(count) || 0;
        if (badge) {
            badge.textContent = total > 99 ? '99+' : total;
            badge.style.display = total ? 'inline-block' : 'none';
            badge.classList.toggle('d-none', !total);
        }
        if (header) header.textContent = `${total} Baru`;
    }

    function renderNotificationList(logs) {
        const container = document.getElementById('notif-list-container');
        const footer = document.getElementById('notif-footer-action');
        if (!container) return;

        if (!logs?.length) {
            container.innerHTML = '<div class="text-center py-4 text-muted small"><i class="bi bi-bell-slash fs-4 d-block mb-1 opacity-50"></i>Tidak ada aktivitas terbaru</div>';
            footer?.classList.add('d-none');
            footer?.classList.remove('d-flex');
            updateBadgeCount(0);
            return;
        }

        footer?.classList.remove('d-none');
        footer?.classList.add('d-flex');
        container.innerHTML = logs.map(log => {
            const id = log.id ?? log.Id;
            const aksi = log.aksi ?? log.Aksi ?? 'Aktivitas';
            const target = log.target ?? log.Target ?? '';
            const detail = log.detail ?? log.Detail ?? 'Aksi sistem tercatat.';
            const actorDisplay = log.actorDisplay ?? log.ActorDisplay ?? 'System';
            const role = log.role ?? log.Role ?? '';
            const isRead = Boolean(log.isRead ?? log.IsRead);
            const notificationUrl = getNotificationUrl(target, detail);
            const rawTime = log.waktu ?? log.Waktu;
            const tone = getNotificationTone(`${aksi} ${target} ${detail}`);
            const icon = getNotificationIcon(`${aksi} ${target} ${detail}`);
            const itemStateClass = isRead ? 'notif-item-read' : 'notif-item-unread';
            const titleClass = isRead ? 'notif-title-read' : 'notif-title-unread';
            const newBadge = isRead ? '' : '<span class="notif-badge-new">Baru</span>';

            return `<article class="notif-item-custom ${itemStateClass}" role="option" aria-label="${isRead ? 'Sudah dibaca' : 'Belum dibaca'}">
                <button type="button" class="notif-item-open" onclick="markAsReadAndAct(${Number(id)}, '${notificationUrl}')">
                    <span class="notif-item-icon notif-tone-${tone}"><i class="bi ${icon}"></i></span>
                    <span class="notif-item-body">
                        <span class="notif-item-heading"><span class="${titleClass}">${escapeHtml(aksi)}${target ? ` · ${escapeHtml(target)}` : ''}</span>${newBadge}</span>
                        <span class="notif-item-meta"><span><i class="bi bi-person-circle"></i>${escapeHtml(actorDisplay)}</span><span class="notif-role">${escapeHtml(role || 'User')}</span></span>
                        <span class="notif-item-detail">${escapeHtml(detail)}</span>
                        <span class="notif-time-ago" data-time="${escapeHtml(rawTime)}"><i class="bi bi-clock"></i>${escapeHtml(formatTimeAgo(rawTime))}</span>
                    </span>
                </button>
                <button type="button" class="notif-delete-btn" title="Hapus notifikasi" aria-label="Hapus notifikasi" onclick="deleteNotification(event, ${Number(id)})"><i class="bi bi-x-lg"></i></button>
            </article>`;
        }).join('');
    }

    function getNotificationTone(value) {
        const text = String(value || '').toLowerCase();
        if (/(terlambat|ditolak|menolak|tolak|gagal|dihapus|menghapus|hapus|rusak)/.test(text)) return 'danger';
        if (/(disetujui|menyetujui|setujui|memvalidasi|berhasil|selesai|dikembalikan|kembali)/.test(text)) return 'success';
        if (/(menunggu|pending|peringatan|jatuh tempo)/.test(text)) return 'warning';
        return 'info';
    }

    function getNotificationIcon(value) {
        const text = String(value || '').toLowerCase();
        if (/(rusak|gagal|ditolak|dihapus|hapus)/.test(text)) return 'bi-exclamation-triangle-fill';
        if (/(disetujui|berhasil|selesai|kembali)/.test(text)) return 'bi-check-circle-fill';
        if (/(peminjaman|dipinjam|dikeluarkan)/.test(text)) return 'bi-arrow-left-right';
        if (/(masuk|menambahkan|dibuat)/.test(text)) return 'bi-box-arrow-in-down';
        if (/(keluar|mengeluarkan)/.test(text)) return 'bi-box-arrow-up';
        if (/(laporan|pdf)/.test(text)) return 'bi-file-earmark-text-fill';
        return 'bi-info-circle-fill';
    }

    function getNotificationUrl(target, detail) {
        const value = String(target || '').toLowerCase();
        const textDetail = String(detail || '').toLowerCase();
        const combined = value + ' ' + textDetail;

        if (combined.includes('validasi') || combined.includes('menyetujui barang') || combined.includes('pending validasi')) {
            return '/Perangkat/Validasi';
        }
        if (combined.includes('arsip')) {
            if (combined.includes('opname')) return '/Opname/Arsip';
            return '/Perangkat/Arsip';
        }
        if (combined.includes('cetak laporan') || combined.includes('laporan')) {
            return '/Perangkat/CetakLaporan';
        }
        if (combined.includes('masuk')) {
            return '/KelolaBarang/Masuk';
        }
        if (combined.includes('keluar')) {
            return '/KelolaBarang/Keluar';
        }
        if (combined.includes('kategori')) {
            return '/KelolaBarang/Kategori';
        }
        if (combined.includes('lokasi') || combined.includes('rak')) {
            return '/KelolaBarang/Rak';
        }
        if (value.includes('peminjaman')) return '/Peminjaman/Index';
        if (value.includes('perangkat')) return '/Perangkat/Index';
        if (value.includes('vendor')) return '/Vendor/Index';
        if (value.includes('user')) return '/User/Index';
        if (value.includes('opname')) return '/Opname/Index';
        if (value.includes('barang')) return '/KelolaBarang/Index';
        if (value.includes('profil')) return '/Profile/Index';

        return '/Home/Index';
    }

    async function markAsReadAndAct(id, url) {
        try {
            await fetch(`/api/activitylog/${id}/read`, { method: 'PUT', credentials: 'include' });
            await loadUnreadCount();
        } catch (error) {
            console.error('Gagal menandai dibaca:', error);
        } finally {
            window.location.href = url || '/Home/Index';
        }
    }

    async function markAllAsRead() {
        try {
            const response = await fetch('/api/activitylog/read-all', { method: 'PUT', credentials: 'include' });
            if (response.ok) { await loadUnreadCount(); await loadActivityLogs(); }
        } catch (error) { console.error('Gagal menandai semua dibaca:', error); }
    }

    async function deleteNotification(event, id) {
        event.preventDefault();
        event.stopPropagation();
        try {
            const response = await fetch(`/api/activitylog/${id}`, { method: 'DELETE', credentials: 'include' });
            if (response.ok) { await loadUnreadCount(); await loadActivityLogs(); }
        } catch (error) { console.error('Gagal menghapus notifikasi:', error); }
    }

    // --- FUNGSI BARU: Hanya Menghapus Notifikasi yang Terbaca ---
    async function clearReadNotifications() {
        try {
            // Ambil hanya notifikasi yang isRead == true
            const readLogs = currentActivityLogs.filter(log => log.isRead || log.IsRead);
            
            if (readLogs.length === 0) {
                // Opsional: Jika tidak ada yang terbaca, abaikan saja (atau bisa tambah Toast Notif)
                return;
            }

            // Hapus secara paralel menggunakan endpoint DELETE by ID yang sudah Anda miliki
            const deletePromises = readLogs.map(log => {
                const id = log.id ?? log.Id;
                return fetch(`/api/activitylog/${id}`, { method: 'DELETE', credentials: 'include' });
            });

            await Promise.all(deletePromises);
            
            // Perbarui antarmuka
            await loadUnreadCount();
            await loadActivityLogs();
        } catch (error) {
            console.error('Gagal membersihkan notifikasi terbaca:', error);
        }
    }
    // -------------------------------------------------------------

    function setupNotificationEvents() {
        document.getElementById('btnMarkAllRead')?.addEventListener('click', event => {
            event.preventDefault();
            markAllAsRead();
        });
        document.getElementById('btnClearAllNotif')?.addEventListener('click', event => {
            event.preventDefault();
            clearReadNotifications(); // <- Pastikan menunjuk ke fungsi baru
        });
    }

    function formatTimeAgo(value) {
        if (!value) return '';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
        if (seconds < 60) return 'Baru saja';
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes} mnt lalu`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} jam lalu`;
        return `${Math.floor(hours / 24)} hari lalu`;
    }

    function escapeHtml(value) {
        return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
    }

    setInterval(() => {
        const timeElements = document.querySelectorAll('.notif-time-ago');
        timeElements.forEach(el => {
            const rawTime = el.getAttribute('data-time');
            if (rawTime) {
                el.innerHTML = `<i class="bi bi-clock me-1"></i>${escapeHtml(formatTimeAgo(rawTime))}`;
            }
        });
    }, 30000);

    function resolveNotificationHubUrl() {
        try {
            const hubUrl = new URL(window.BACKEND_BASE_URL || window.location.origin, window.location.origin);

            hubUrl.pathname = '/notificationHub';
            hubUrl.search = '';
            hubUrl.hash = '';
            return hubUrl.toString();
        } catch (error) {
            console.warn('URL SignalR tidak valid, memakai origin aplikasi.', error);
            return `${window.location.origin}/notificationHub`;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        refreshNotificationState(false);
        setupNotificationEvents();

        // Fallback sinkronisasi menjaga notifikasi tetap terbarui jika SignalR
        // terputus, tab baru aktif kembali, atau jaringan sempat berpindah.
        window.setInterval(() => {
            if (!document.hidden) refreshNotificationState(true);
        }, 5000);
        window.addEventListener('focus', () => refreshNotificationState(true));
        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) refreshNotificationState(true);
        });

        if (typeof signalR === 'undefined') {
            return;
        }

        window.notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl(resolveNotificationHubUrl(), { withCredentials: true })
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        window.notificationConnection.on('ReceiveNotification', async function () {
            await refreshNotificationState(false);
            window.dispatchEvent(new CustomEvent('sigma:notification'));

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'info',
                    title: 'Ada aktivitas atau notifikasi baru!',
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true,
                    customClass: { popup: 'rounded-4 shadow-sm' }
                });
            }
        });

        window.notificationConnection.onreconnected(() => refreshNotificationState(true));

        window.notificationConnection.start()
            .then(function () { console.log('SignalR Connected'); })
            .catch(function (error) { console.warn('SignalR error:', error.toString()); });
    });
</script>
