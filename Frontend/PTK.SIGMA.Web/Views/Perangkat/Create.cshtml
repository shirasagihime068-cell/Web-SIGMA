@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Tambah Barang - SIGMA";
    var apiBaseUrl = "";
}

@section Styles {
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fadeInUp 0.4s ease-out forwards;
        }

        .btn-pertamina-red {
            background-color: #ED1B24;
            color: white;
            border: none;
        }

        .btn-pertamina-red:hover {
            background-color: #d0121a;
            color: white;
        }

        .custom-dropdown-container {
            position: relative;
            width: 100%;
        }

        .custom-select-input {
            cursor: pointer;
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 1rem;
            border-radius: 50rem;
            font-size: 0.85rem;
        }

        .custom-select-input:hover,
        .custom-select-input.active {
            border-color: #003876;
            box-shadow: 0 0 0 0.2rem rgba(0, 56, 118, 0.15);
            background-color: white;
        }

        .custom-dropdown-list {
            position: absolute;
            z-index: 1050;
            width: 100%;
            max-height: 250px;
            overflow-y: auto;
            display: none;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
            margin-top: 8px;
            border: 1px solid #dcdcdc;
            padding: 8px 0;
        }

        .dropdown-item-custom {
            cursor: pointer;
            padding: 8px 20px;
            font-size: 0.85rem;
        }

        .dropdown-item-custom:hover {
            background-color: #e6f0fa;
            color: #003876;
        }
    </style>
}

<script>
    window.API_BASE_URL = '@apiBaseUrl';
</script>

<div class="container-fluid py-3 py-md-4 animate-fade-in px-3 px-xl-4 perangkat-form-shell">
    <div class="card border-0 shadow-sm rounded-4 w-100 bg-white perangkat-form-card">
        <!-- HEADER -->
        <div class="card-header bg-white border-bottom p-4 d-flex align-items-center rounded-top-4">
            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                 style="width: 50px; height: 50px;">
                <i class="bi bi-plus-lg text-primary fs-5"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark m-0">
                    Tambah Barang Berdasarkan Kategori
                </h5>
                <p class="text-muted small m-0 mt-1">
                    Form input akan menyesuaikan dengan kategori perangkat SIGMA yang dipilih.
                </p>
            </div>
        </div>

        <!-- BODY -->
        <div class="card-body p-4 p-md-5" style="font-size: 0.85rem;">
            <form id="formCreatePerangkat" enctype="multipart/form-data">
                <input type="hidden" name="LokasiId" id="hiddenLokasiId" />

                <!-- KATEGORI -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark small text-uppercase">
                        Kategori Barang
                        <span class="text-danger">*</span>
                    </label>
                    <div class="custom-dropdown-container">
                        <div class="custom-select-input shadow-sm border" id="kategoriBox"
                             onclick="toggleDropdown('kategoriList', 'kategoriBox')">
                            <span id="kategoriText">
                                Pilih Kategori
                            </span>
                            <i class="bi bi-chevron-down"></i>
                        </div>
                        <input type="hidden" name="Kategori" id="hiddenKategori" />
                        <div class="custom-dropdown-list shadow-lg" id="kategoriList">
                        </div>
                    </div>
                </div>

                <!-- FORM LAPTOP -->
                <div id="formLaptop" class="d-none p-3 mb-3 rounded-4 bg-light border">
                    <div class="fw-bold text-primary mb-2 small text-uppercase">
                        <i class="bi bi-laptop me-1"></i>
                        Informasi Khusus Laptop
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">
                                Type Laptop
                            </label>
                            <input name="TypeLaptop" class="form-control rounded-pill py-2 px-3 border shadow-sm"
                                   placeholder="Contoh: HP ProBook 440 G8" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">
                                Product ID
                            </label>
                            <input name="ProductId" class="form-control rounded-pill py-2 px-3 border shadow-sm"
                                   placeholder="Contoh: PRD-001" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-dark small">
                            Serial Number (SN)
                        </label>
                        <textarea name="SnLaptop" rows="2" class="form-control rounded-4 py-2 px-3 border shadow-sm"
                                  placeholder="Contoh: 5CD12345XYZ, 5CD12345ABC"></textarea>
                    </div>
                </div>

                <!-- FORM UMUM -->
                <div id="formUmum" class="d-none">
                    <!-- LOKASI -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Lokasi Rak / Penyimpanan
                        </label>
                        <div class="custom-dropdown-container">
                            <div class="custom-select-input shadow-sm border" id="jenisLokasiBox"
                                 onclick="toggleDropdown('jenisLokasiList', 'jenisLokasiBox')">
                                <span id="jenisLokasiText">
                                    Pilih Rak
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <input type="hidden" name="LokasiRak" id="hiddenJenisLokasi" />
                            <div class="custom-dropdown-list shadow-lg" id="jenisLokasiList">
                            </div>
                        </div>
                    </div>

                    <!-- NAMA -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Nama Perangkat
                            <span class="text-danger">*</span>
                        </label>
                        <input name="Nama" class="form-control rounded-pill py-2 px-3 border shadow-sm"
                               placeholder="Masukkan nama perangkat..." required />
                    </div>

                    <!-- JUMLAH -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Jumlah
                            <span class="text-danger">*</span>
                        </label>
                        <input name="Jumlah" type="number" class="form-control rounded-pill py-2 px-3 border shadow-sm"
                               value="1" min="1" required />
                    </div>

                    <!-- STATUS -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Status
                        </label>
                        <div class="custom-dropdown-container">
                            <div class="custom-select-input shadow-sm border" id="statusBox"
                                 onclick="toggleDropdown('statusList', 'statusBox')">
                                <span id="statusText">
                                    Aset
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <input type="hidden" name="StatusSewa" id="hiddenStatus" value="Aset" />
                            <div class="custom-dropdown-list shadow-lg" id="statusList">
                                <div class="dropdown-item-custom"
                                     onclick="pilihCustom('Aset', 'Aset', 'hiddenStatus', 'statusText', 'statusList', 'statusBox')">
                                    Aset
                                </div>
                                <div class="dropdown-item-custom"
                                     onclick="pilihCustom('Sewa', 'Sewa', 'hiddenStatus', 'statusText', 'statusList', 'statusBox')">
                                    Sewa
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VENDOR -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Vendor
                            <span class="text-danger">*</span>
                        </label>
                        <div class="custom-dropdown-container">
                            <div class="custom-select-input shadow-sm border" id="vendorBox"
                                 onclick="toggleDropdown('vendorList', 'vendorBox')">
                                <span id="vendorText">
                                    Pilih Vendor
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <input type="hidden" name="VendorId" id="hiddenVendor" />
                            <div class="custom-dropdown-list shadow-lg" id="vendorList">
                            </div>
                        </div>
                    </div>

                    <!-- KONDISI -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Kondisi Barang
                            <span class="text-danger">*</span>
                        </label>
                        <div class="custom-dropdown-container">
                            <div class="custom-select-input shadow-sm border" id="kondisiBox"
                                 onclick="toggleDropdown('kondisiList', 'kondisiBox')">
                                <span id="kondisiText">
                                    Baik
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <input type="hidden" name="Kondisi" id="hiddenKondisi" value="Baik" />
                            <div class="custom-dropdown-list shadow-lg" id="kondisiList">
                                <div class="dropdown-item-custom"
                                     onclick="pilihCustom('Baik', 'Baik', 'hiddenKondisi', 'kondisiText', 'kondisiList', 'kondisiBox')">
                                    Baik
                                </div>
                                <div class="dropdown-item-custom"
                                     onclick="pilihCustom('Rusak', 'Rusak', 'hiddenKondisi', 'kondisiText', 'kondisiList', 'kondisiBox')">
                                    Rusak
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KETERANGAN -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Keterangan
                        </label>
                        <input name="Keterangan" class="form-control rounded-pill py-2 px-3 border shadow-sm"
                               placeholder="Masukkan keterangan..." />
                    </div>

                    <!-- FOTO -->
                    <div class="mb-4 mt-3 border-top pt-3">
                        <label class="form-label fw-semibold text-dark small text-uppercase">
                            Dokumentasi Foto Perangkat
                        </label>
                        <div class="dropdown">
                            <button
                                class="btn btn-outline-danger w-100 rounded-pill btn-sm py-2 fw-semibold shadow-sm dropdown-toggle"
                                type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-camera-fill fs-5"></i>
                                Pilih Sumber Foto
                            </button>
                            <ul class="dropdown-menu w-100 shadow-lg p-2">
                                <li>
                                    <button class="dropdown-item rounded-3 py-2" type="button"
                                            onclick="triggerPhoto('camera')">
                                        Ambil dari Kamera
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item rounded-3 py-2" type="button"
                                            onclick="triggerPhoto('gallery')">
                                        Pilih dari Galeri
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <input type="file" id="inputDokumentasiUtama" name="FileDokumentasi" accept="image/*"
                               class="d-none" onchange="previewSelectedImage(this)" />

                        <div id="imagePreviewContainer" class="mt-2 text-center p-2 border rounded-4 bg-light"
                             style="display: none;">
                            <img id="previewImg" src="#" class="rounded-3 shadow-sm mb-2"
                                 style="max-height: 120px; object-fit: contain;" />
                            <br>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-0"
                                    onclick="resetImageSelection()">
                                Hapus Foto
                            </button>
                        </div>
                    </div>

                    <!-- BUTTON -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/KelolaBarang/Index"
                           class="btn btn-light border rounded-pill px-4 py-2 fw-semibold shadow-sm">
                            Batal
                        </a>
                        <button type="submit"
                                class="btn btn-pertamina-red rounded-pill px-4 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-save me-1"></i> Simpan Data
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const res = await fetch(`${window.API_BASE_URL}/api/perangkat/create-options`, {
                    method: 'GET',
                    credentials: 'include',
                    headers: { 'Accept': 'application/json' }
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const responseData = await res.json();
                const data = responseData.data || {};

                if (!responseData.success) {
                    throw new Error(responseData.message || 'Gagal mengambil opsi data.');
                }

                /* ========================= LOKASI ========================= */
                if (data.lokasiList && data.lokasiList.length > 0) {
                    document.getElementById('hiddenLokasiId').value = data.lokasiList[0].id;
                }

                /* ========================= KATEGORI ========================= */
                let katHtml = '';
                (data.kategoriList || []).forEach(k => {
                    const kategori = encodeURIComponent(String(k)).replace(/'/g, '%27');
                    katHtml += `<div class="dropdown-item-custom" onclick="pilihKategori(decodeURIComponent('${kategori}'))">${window.escapeHtml(k)}</div>`;
                });
                document.getElementById('kategoriList').innerHTML = katHtml;

                /* ========================= RAK ========================= */
                window.renderSigmaRackDropdown(
                    document.getElementById('jenisLokasiList'),
                    data.lokasiRakList || [],
                    (value, label) => pilihCustom(value, label, 'hiddenJenisLokasi', 'jenisLokasiText', 'jenisLokasiList', 'jenisLokasiBox'),
                    { placeholder: 'Pilih Rak' }
                );

                /* ========================= VENDOR ========================= */
                let vendorHtml = '';
                (data.vendorList || []).forEach(v => {
                    const vendorId = encodeURIComponent(String(v.id)).replace(/'/g, '%27');
                    const vendorName = encodeURIComponent(String(v.namaVendor)).replace(/'/g, '%27');
                    vendorHtml += `<div class="dropdown-item-custom" onclick="pilihCustom(decodeURIComponent('${vendorId}'), decodeURIComponent('${vendorName}'), 'hiddenVendor', 'vendorText', 'vendorList', 'vendorBox')">${window.escapeHtml(v.namaVendor)}</div>`;
                });
                document.getElementById('vendorList').innerHTML = vendorHtml;

            } catch (error) {
                console.error('Gagal memuat opsi:', error);
                Swal.fire('Gagal', 'Tidak dapat mengambil data dari server.', 'error');
            }
        });

        /* ========================= SUBMIT FORM ========================= */
        document.getElementById('formCreatePerangkat').addEventListener('submit', async (e) => {
            e.preventDefault();

            const kategori = document.getElementById('hiddenKategori').value;
            const vendor = document.getElementById('hiddenVendor').value;

            if (!kategori) {
                Swal.fire('Peringatan', 'Harap pilih Kategori!', 'warning');
                return;
            }

            if (!vendor) {
                Swal.fire('Peringatan', 'Harap pilih Vendor!', 'warning');
                return;
            }

            const formData = new FormData(e.target);

            // Set nilai input tersembunyi (hidden inputs)
            formData.set('Kategori', kategori);
            formData.set('VendorId', vendor);
            formData.set('LokasiId', document.getElementById('hiddenLokasiId').value);
            formData.set('LokasiRak', document.getElementById('hiddenJenisLokasi').value || '');
            formData.set('StatusSewa', document.getElementById('hiddenStatus').value);
            formData.set('Kondisi', document.getElementById('hiddenKondisi').value);

            try {
                const res = await fetch(`${window.API_BASE_URL}/api/perangkat`, {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });

                // Ambil respons mentah dari server (bisa JSON atau teks error HTML)
                const responseText = await res.text();
                let result;
                try {
                    result = JSON.parse(responseText);
                } catch (parseError) {
                    result = { success: false, message: responseText || `HTTP Error ${res.status}` };
                }

                if (!res.ok) {
                    let errorMessages = result.message || `Terjadi kesalahan (HTTP ${res.status}).`;
                    if (result.errors) {
                        const errorList = Object.values(result.errors).flat();
                        if (errorList.length > 0) {
                            errorMessages = errorList.join('<br>');
                        }
                    }
                    Swal.fire('Gagal!', errorMessages, 'error');
                    return;
                }

                if (result.success) {
                    Swal.fire('Berhasil!', result.message || 'Data dan foto berhasil disimpan.', 'success')
                        .then(() => { window.location.href = '/Perangkat/Index'; });
                } else {
                    Swal.fire('Gagal!', result.message || 'Terjadi kesalahan.', 'error');
                }
            } catch (error) {
                console.error("Fetch Error Detail:", error);
                // Menampilkan error asli agar terlihat di layar
                Swal.fire('Kesalahan Sistem!', error.message || 'Tidak dapat terhubung ke server.', 'error');
            }
        });

        /* ========================= DROPDOWN ========================= */
        function toggleDropdown(listId, boxId) {
            document.querySelectorAll('.custom-dropdown-list').forEach(el => {
                if (el.id !== listId) el.style.display = 'none';
            });
            const list = document.getElementById(listId);
            if (!list) return;
            list.style.display = list.style.display === 'block' ? 'none' : 'block';
        }

        /* ========================= PILIH CUSTOM ========================= */
        function pilihCustom(val, text, hiddenId, textId, listId, boxId) {
            const hidden = document.getElementById(hiddenId);
            const textElement = document.getElementById(textId);
            const list = document.getElementById(listId);

            if (hidden) hidden.value = val;
            if (textElement) textElement.innerText = text;
            if (list) list.style.display = 'none';
        }

        /* ========================= PILIH KATEGORI ========================= */
        function pilihKategori(kat) {
            pilihCustom(kat, kat, 'hiddenKategori', 'kategoriText', 'kategoriList', 'kategoriBox');
            
            const formUmum = document.getElementById('formUmum');
            const formLaptop = document.getElementById('formLaptop');

            formUmum.classList.remove('d-none');
            
            if (kat && kat.toLowerCase().includes('laptop')) {
                formLaptop.classList.remove('d-none');
            } else {
                formLaptop.classList.add('d-none');
            }
        }

        /* ========================= CLOSE DROPDOWN ========================= */
        document.addEventListener('click', e => {
            if (!e.target.closest('.custom-dropdown-container')) {
                document.querySelectorAll('.custom-dropdown-list').forEach(el => {
                    el.style.display = 'none';
                });
            }
        });

        /* ========================= FOTO ========================= */
        function triggerPhoto(mode) {
            const input = document.getElementById('inputDokumentasiUtama');
            if (!input) return;

            if (mode === 'camera') {
                input.setAttribute('capture', 'environment');
            } else {
                input.removeAttribute('capture');
            }
            input.click();
        }

        /* ========================= PREVIEW FOTO ========================= */
        function previewSelectedImage(input) {
            if (!input.files || !input.files[0]) return;
            
            const file = input.files[0];
            if (file.size > 20 * 1024 * 1024) {
                Swal.fire('Ukuran terlalu besar', 'Maksimal gambar 20MB!', 'warning');
                input.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('imagePreviewContainer').style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        /* ========================= RESET FOTO ========================= */
        function resetImageSelection() {
            const input = document.getElementById('inputDokumentasiUtama');
            const preview = document.getElementById('imagePreviewContainer');
            
            if (input) input.value = '';
            if (preview) preview.style.display = 'none';
        }
    </script>
}
